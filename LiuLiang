      printf '  %s %s %s %s\n' "$(padr "$k" 18)" "$(padl "$(fmt_bytes "$q")" 14)" "$(padl "$(fmt_bytes "$pused")" 14)" "$(padl "$(pct_str "$pused" "$q")" 8)"
