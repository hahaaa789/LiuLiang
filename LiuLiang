# nftables 版本能力提示
nft_feature_note() {
  local v major minor
  v=$(nft --version 2>/dev/null | awk '{print $2}'); v=${v#v}
  [[ -z ${v:-} ]] && { printf '未检测到'; return; }
  major=${v%%.*}; minor=${v#*.}; minor=${minor%%.*}
  [[ $major =~ ^[0-9]+$ ]] || { printf ''; return; }
  if (( major < 1 )); then
    printf '0.9.x 系列: 已改用空标记链, 兼容'
  else
    printf '1.x 系列: 全部特性可用'
  fi
}

# nft 表达式兼容性自检: 在一张临时表里试建关键规则, 确认当前内核/nft 版本
# 是否接受, 建完立刻删除, 不影响现网规则
nft_selftest() {
  local t="trafmgr_selftest" tmp rc_all=0
  nft_ok || { echo "  未安装 nft, 无法自检"; return 1; }
  nft list table inet "$t" >/dev/null 2>&1 && nft delete table inet "$t" 2>/dev/null
  echo
  printf '  nftables 版本: %s\n' "$(nft --version 2>/dev/null | awk '{print $2}')"
  hr
  local -a names=(
    "空标记链 (归属标记)"
    "基础 counter 规则"
    "单端口 limit rate over"
    "ct original proto-dst 单端口"
    "ct original proto-dst 端口段"
    "ct direction original/reply"
  )
  local -a rules=(
    ""
    "tcp dport 12345 counter"
    "tcp dport 12345 limit rate over 128 kbytes/second burst 32 kbytes drop"
    "meta l4proto tcp ct original proto-dst 12345 limit rate over 128 kbytes/second burst 32 kbytes drop"
    "meta l4proto tcp ct original proto-dst 20000-20010 limit rate over 128 kbytes/second burst 32 kbytes drop"
    "meta l4proto tcp ct original proto-dst 12345 ct direction original limit rate over 128 kbytes/second burst 32 kbytes drop"
  )
  tmp=$(mktemp) || return 1
  printf 'table inet %s {\n  chain %s { }\n  chain t { type filter hook output priority 100; policy accept; }\n}\n' "$t" "$NFT_MARK_CHAIN" > "$tmp"
  if nft -f "$tmp" 2>/dev/null; then
    printf '  %s %s通过%s\n' "$(padr "${names[0]}" 34)" "$C_G" "$C_R"
  else
    printf '  %s %s失败 (归属标记不可用, 请反馈)%s\n' "$(padr "${names[0]}" 34)" "$C_E" "$C_R"
    rm -f "$tmp"; return 1
  fi
  rm -f "$tmp"
  local i
  for i in 1 2 3 4 5; do
    if nft add rule inet "$t" t ${rules[$i]} 2>/dev/null; then
      printf '  %s %s通过%s\n' "$(padr "${names[$i]}" 34)" "$C_G" "$C_R"
    else
      printf '  %s %s不支持%s\n' "$(padr "${names[$i]}" 34)" "$C_Y" "$C_R"
      rc_all=1
    fi
  done
  nft delete table inet "$t" 2>/dev/null
  hr
  if (( rc_all == 0 )); then
    printf '  %s全部表达式均被当前 nftables 接受%s\n' "$C_G" "$C_R"
  else
    printf '  %s部分表达式不受支持。限速表会自动降级为逐条下发,%s\n' "$C_Y" "$C_R"
    printf '  %s不被接受的规则会被跳过并记入日志, 其余限速照常生效。%s\n' "$C_Y" "$C_R"
  fi
  audit "nft 兼容性自检完成 结果=$( (( rc_all == 0 )) && echo 全部通过 || echo 部分不支持 )"
  return 0
}

