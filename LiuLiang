           pquota_set "$REPLY_VAL" 0; enforce_reap_ports; echo "  已删除, 相关自动限速已解除"
         else echo "  未找到"; fi; pause ;;
      0|"") return ;;
      *) echo "  无效选择"; pause ;;
    esac
  done
}

# ---------------------------------------------------------------- 菜单: 限速
menu_limits() {
  while :; do
    cfg_load
    title "限速规则     nftables limit, 不改动网卡 qdisc"
    printf '  %s本机端口走 input/output 链; 转发端口走 forward 链 (ct original proto-dst)%s\n' "$C_D" "$C_R"
    printf '  %s类型未知的端口保守处理: input/output 与 forward 全部挂载%s\n' "$C_D" "$C_R"
    printf '  %s速率按比特率解释: 1M = 1Mbps = 1000000 bit/s%s\n' "$C_D" "$C_R"
    hr
    # 状态列含 ANSI 着色码, 不能计入宽度: 必须先 pad 再着色
    printf '  %s %s %s %s %s  %s\n' "$(padr 规则 22)" "$(padr 端口 10)" "$(padr 方向 6)" "$(padl 速率 10)" "$(padr 状态 6)" 来源
    local i=0
    while IFS=$'\t' read -r k proto port dirn rate st src; do
      [[ -z ${k:-} ]] && continue
      i=$((i+1))
      local stxt srctxt
      if [[ $st == on ]]; then stxt="${C_G}$(padr 生效 6)${C_R}"; else stxt="$(padr 暂停 6)"; fi
      if [[ ${src:-manual} == "$ENF_TAG" ]]; then srctxt="${C_E}超额自动${C_R}"; else srctxt="手动"; fi
      printf '  %s %s %s %s %s  %s\n' "$(padr "$k" 22)" "$(padr "$port/$proto" 10)" "$(padr "$dirn" 6)" \
        "$(padl "$rate" 10)" "$stxt" "$srctxt"
    done < <(cat "$LIMITS" 2>/dev/null)
    (( i == 0 )) && printf '  %s暂无限速规则%s\n' "$C_D" "$C_R"
    printf '  %s %s %s %s %s  %s\n' "$(padr "-" 22)" "$(padr "${RSSH_LIST:-$RSSH}" 10)" "$(padr "-" 6)" "$(padl "-" 10)" "$(padr "-" 6)" "SSH 豁免列表, 不可限速"
    hr
    echo "    1)  新增限速规则"
    echo "    2)  删除限速规则"
    echo "    3)  启用 / 暂停规则"
    echo "    4)  清空全部限速"
    echo "    0)  返回"
    printf '\n  回车返回\n  请选择: '
    read -r c || return 0
    case ${c:-0} in
      1) ask_port "端口号" || continue
         echo "    1) tcp   2) udp"; ask "协议" "1"
         local pr; [[ $REPLY_VAL == 2 ]] && pr=udp || pr=tcp
         echo "    1) 出站   2) 入站   3) 双向"; ask "方向" "1"
         local dn; case $REPLY_VAL in 2) dn=in;; 3) dn=both;; *) dn=out;; esac
         ask_rate "速率 (如 1M / 100M / 500K)" "1M" || continue
         local kd; kd=$(port_kind_of "$(pkey "$pr" "$PORT_VAL")")
         echo "  预览: $pr 端口 $PORT_VAL 方向 $dn 限速 $RATE_VAL ($(parse_rate_kbs "$RATE_VAL") kbytes/second)"
         # 预览文案必须与实际挂链位置一致
         echo "        端口类型 $kd -> 规则将挂在 $(kind_hook_desc "$kd")"
         [[ $kd == unknown ]] && echo "        提示: 可在菜单 6 手动添加该端口并指定类型, 使限速更精确"
         confirm "确认添加" && { limit_add "$pr" "$PORT_VAL" "$dn" "$RATE_VAL" manual && echo "  已添加并生效"; }; pause ;;
      2) ask "输入要删除的规则名 (第一列)" ""; [[ -z $REPLY_VAL ]] && continue
         if limit_del "$REPLY_VAL"; then echo "  已删除"; else echo "  未找到"; fi; pause ;;
      3) ask "输入要切换的规则名" ""; [[ -z $REPLY_VAL ]] && continue
         if limit_toggle "$REPLY_VAL"; then echo "  已切换"; else echo "  未找到"; fi; pause ;;
      4) if confirm_danger "将删除全部限速规则"; then
           audit "清空全部限速规则  原有 $(nlines "$LIMITS") 条"
           tsv_truncate "$LIMITS"; nft_limit_build; echo "  已清空"
         fi; pause ;;
      0|"") return ;;
      *) echo "  无效选择"; pause ;;
    esac
  done
}

# ---------------------------------------------------------------- 菜单: 端口清单
menu_portlist() {
  while :; do
    cfg_load
    title "端口监控清单     自动发现 $( [[ ${AUTO_DISCOVER:-1} == 1 ]] && echo 已启用 || echo 已关闭 )"
    hr
    # 全部走 padr, 否则中文列会错位
    printf '  %s %s %s %s %s %s\n' "$(padr 端口 16)" "$(padr 类型 6)" "$(padr 来源 8)" "$(padr 状态 6)" "$(padr 备注 20)" 最近在线
    local n=0 ngone=0
    while IFS=$'\t' read -r k proto port kind note src first state last; do
      [[ -z ${k:-} ]] && continue
      n=$((n+1))
      local kd st
      case $kind in local) kd=本机;; fwd) kd=转发;; redir) kd=跳跃;; *) kd=$kind;; esac
      # SSH 标注按区间判断
      local kport=${k%%/*}
      { port_overlaps_ssh "$kport" && [[ $k == *"/tcp" ]]; } && kd="$kd*"
      if [[ ${state:-live} == gone ]]; then st="${C_D}$(padr 已下线 6)${C_R}"; ngone=$((ngone+1)); else st="${C_G}$(padr 在线 6)${C_R}"; fi
      printf '  %s %s %s %s %s %s\n' "$(padr "$k" 16)" "$(padr "$kd" 6)" "$(padr "$src" 8)" "$st" "$(padr "${note:--}" 20)" "${last:-未知}"
    done < <(sort -t$'\t' -k3,3n "$PORTS" 2>/dev/null)
    (( n == 0 )) && printf '  %s暂无端口, 下次采集将自动发现%s\n' "$C_D" "$C_R"
    hr
    printf '  共 %d 个   其中已下线 %d 个   自动清理: 下线超过 %s 天且本周期无流量\n' "$n" "$ngone" "${STALE_KEEP_DAYS:-30}"
    printf '  %s标 * 者与 SSH 豁免列表 (%s) 有交集, 限速时强制豁免。手动添加的端口不会被自动下线%s\n' "$C_D" "${RSSH_LIST:-$RSSH}" "$C_R"
    echo
    echo "    1)  手动添加端口"
    echo "    2)  删除端口"
    echo "    3)  自动发现开关"
    echo "    4)  立即重新扫描"
    echo "    5)  立即清理已下线端口"
    echo "    6)  修改自动清理天数"
    echo "    7)  转发计数开关 (COUNT_FORWARD)"
    echo "    0)  返回"
    printf '\n  回车返回\n  请选择: '
    read -r c || return 0
    case ${c:-0} in
      1) ask_port "端口号 (如 8443 或 60000-62700)" || continue
         echo "    1) tcp   2) udp"; ask "协议" "1"
         local pr; [[ $REPLY_VAL == 2 ]] && pr=udp || pr=tcp
         echo "    1) 本机服务   2) 端口转发"; ask "类型" "1"
         local kd; [[ $REPLY_VAL == 2 ]] && kd=fwd || kd=local
         ask "备注 (可选)" "-"; local nt=${REPLY_VAL:--}
         if port_add "$pr" "$PORT_VAL" "$kd" "$nt" manual; then
           nft_rebuild_safe; echo "  已添加并生效 (来源标记为 manual, 不会被自动下线)"
         else echo "  该端口已在清单中且无需变更"; fi
         pause ;;
      2) ask "输入要删除的端口 (格式 端口/协议, 如 8443/tcp)" ""; [[ -z $REPLY_VAL ]] && continue
         if port_del "$REPLY_VAL"; then nft_rebuild_safe; echo "  已删除"; else echo "  未找到"; fi; pause ;;
      3) if [[ ${AUTO_DISCOVER:-1} == 1 ]]; then cfg_set AUTO_DISCOVER 0; else cfg_set AUTO_DISCOVER 1; fi ;;
      4) local before after rc
         before=$(nlines "$PORTS")
         if [[ ${AUTO_DISCOVER:-1} != 1 ]]; then
           echo "  提示: 自动发现当前为关闭状态, 本次为手动强制扫描"
         fi
         do_discover force; rc=$?
         after=$(nlines "$PORTS")
         if (( rc == 0 )); then
           if nft_rebuild_safe; then
             echo "  扫描完成, 端口清单有变化 ($before -> $after 个), 计数表已重建"
           else
             echo "  扫描完成但计数表重建失败, 详见菜单 9 日志"
           fi
         else
           echo "  扫描完成, 端口清单无变化 (共 $after 个), 未重建计数表"
         fi
         pause ;;
      5) local m=0 kept=0 cu cd
         while IFS=$'\t' read -r k proto port kind note src first state last; do
           [[ -z ${k:-} ]] && continue
           [[ ${state:-live} == gone ]] || continue
           # 与自动清理保持一致: 本周期仍有流量的条目不删, 否则统计会变成无归属的孤儿记录
           read -r cu cd <<<"$(acc_get "$k" "$CYCLE")"
           if (( cu + cd > 0 )); then kept=$(( kept + 1 )); continue; fi
           tsv_del "$PORTS" "$k"; audit "手动清理已下线端口 $k"; port_purge_refs "$k"; m=$((m+1))
         done < <(cat "$PORTS" 2>/dev/null)
         (( m > 0 )) && nft_rebuild_safe
         echo "  已清理 $m 个"
         (( kept > 0 )) && echo "  保留 $kept 个: 本周期仍有流量, 待下次周期重置后可清理"
         pause ;;
      6) ask "已下线端口保留天数 (0 = 永不自动清理)" "${STALE_KEEP_DAYS:-30}"
         if [[ $REPLY_VAL =~ ^[0-9]+$ ]]; then cfg_set STALE_KEEP_DAYS "$REPLY_VAL"; else echo "  须为数字"; pause; fi ;;
      7) # 指纹已纳入该开关, 改完立即重建即可生效
         if [[ ${COUNT_FORWARD:-1} == 1 ]]; then
           cfg_set COUNT_FORWARD 0 && { nft_rebuild_safe; echo "  转发计数已关闭, 计数表已重建"; }
         else
           cfg_set COUNT_FORWARD 1 && { nft_rebuild_safe; echo "  转发计数已开启, 计数表已重建"; }
         fi; pause ;;
      0|"") return ;;
      *) echo "  无效选择"; pause ;;
    esac
  done
}

