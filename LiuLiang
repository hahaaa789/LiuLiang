# 历史用量展示: DAILY_DIR 下的按月归档在此读出
show_history() {
  title "历史用量     数据目录 $DAILY_DIR"
  hr
  local mf n=0
  printf '  %s %s %s %s\n' "$(padr 日期 14)" "$(padl 上传 14)" "$(padl 下载 14)" "$(padl 合计 14)"
  mf="$DAILY_DIR/$(date +%Y-%m).tsv"
  if [[ -f $mf ]]; then
    local d u dn
    while IFS=$'\t' read -r d u dn; do
      [[ -z ${d:-} ]] && continue
      [[ $u =~ ^[0-9]+$ && $dn =~ ^[0-9]+$ ]] || continue
      printf '  %s %s %s %s\n' "$(padr "$d" 14)" "$(padl "$(fmt_bytes "$u")" 14)" "$(padl "$(fmt_bytes "$dn")" 14)" "$(padl "$(fmt_bytes "$((u+dn))")" 14)"
      n=$(( n + 1 ))
    done < <(sort -t$'\t' -k1,1 "$mf" 2>/dev/null)
  fi
  (( n == 0 )) && printf '  %s本月暂无按日记录%s\n' "$C_D" "$C_R"
  hr
  printf '  按月归档文件\n'
  local f b
  for f in $(ls -1 "$DAILY_DIR"/*.tsv 2>/dev/null | sort); do
