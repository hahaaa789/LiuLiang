#!/usr/bin/env bash
# trafmgr - Linux 流量统计与管理
# 适用: Debian 11/12+ / Ubuntu 20.04+ , 依赖 nftables + systemd
#
# 设计要点:
#   1) 所有数值运算走 bash 64 位整数, awk 只处理文本 (规避 mawk 32 位截断)
#   2) 单位一律十进制: 1KB=1000B, 1MB=1000KB, 1GB=1000MB, 1TB=1000GB
#      手动输入不带单位时按 GB 解释 (500 = 500GB)
#   3) nft 计数表独立于用户现有规则, 只有 counter, 无任何 drop/reject
#   4) 网卡按 /sys/class/net/X/device 判定物理性, 不猜名字
#   5) 全量明文日志, 变更前后值均记录
#
# 几条容易被"顺手改掉"的约定, 动手前请先读:
#
#   未启用 set -e
#     本脚本大量函数用返回值传递业务语义 (如 port_add 返回 1 表示"无变化"),
#     grep -c 无匹配也返回 1, [[ ]] && ... 惯用法遍布全文。开启 -e 会大面积
#     误退出。正确做法是在关键写入点逐个检查返回值 (见 cfg_set / atomic_write
#     / tsv_put), 而不是全局 -e。
#
#   nft 表归属标记用空链而非 comment
#     chain 级 comment 需要 nftables 1.0.3+, 在 Debian 11 (0.9.8) 与
#     Ubuntu 20.04 (0.9.3) 上会直接语法报错导致建表失败。空链所有版本都支持,
#     且不挂 hook 就不处理任何报文, 零开销。不要改回 comment 写法。
#
#   归属标记只防撞名, 不防攻击
#     标记的用途是避免误删用户已有的同名表。能伪造标记的前提是已经拿到 root,
#     那时威胁模型已不成立, 无需在此加固。
#
#   不为 nft 操作引入两阶段提交
#     nft -f 内部本身就是原子事务; 归属检查与实际写入之间的竞态需要另一个 root
#     在毫秒级抢建同名表才能利用, 单管理员场景不可达。多文件状态短暂不一致会在
#     下一轮采集中自愈, 已用统一采集锁覆盖现实场景。
#
set -uo pipefail

VERSION="1.7.1"
REPO_RAW="${TRAFMGR_REPO:-https://raw.githubusercontent.com/hahaaa789/LiuLiang/main/LiuLiang}"

# ---------------------------------------------------------------- 路径
CFG_DIR="${TRAFMGR_CFG_DIR:-/etc/trafmgr}"
LIB_DIR="${TRAFMGR_LIB_DIR:-/var/lib/trafmgr}"
LOG_DIR="${TRAFMGR_LOG_DIR:-/var/log}"
BIN_PATH="${TRAFMGR_BIN:-/usr/local/sbin/trafmgr}"
UNIT_DIR="${TRAFMGR_UNIT_DIR:-/etc/systemd/system}"

CFG="$CFG_DIR/config"
PORTS="$CFG_DIR/ports.tsv"
LIMITS="$CFG_DIR/limits.tsv"
PQUOTA="$CFG_DIR/pquota.tsv"
SNAP="$LIB_DIR/last.snap"
CYCLE="$LIB_DIR/cycle.tsv"
LIFE="$LIB_DIR/life.tsv"
CYCLE_START="$LIB_DIR/cycle.start"
STAMP="$LIB_DIR/install.stamp"
LASTRUN="$LIB_DIR/last.run"
DAILY_DIR="$LIB_DIR/daily"
STATE_DIR="$LIB_DIR/state"
FAILED_NFT="$LIB_DIR/last-failed.nft"

LOG="$LOG_DIR/trafmgr.log"
AUDIT="$LOG_DIR/trafmgr-audit.log"

NFT_TABLE_DEFAULT="trafmgr"

# 所有 mktemp 统一落到本进程私有目录, 退出时整体清理, 避免中断后在 /tmp 留残片
TM_TMPDIR=""
_tm_tmpdir_init() {
  [[ -n $TM_TMPDIR && -d $TM_TMPDIR ]] && return 0
  TM_TMPDIR=$(mktemp -d "${TMPDIR:-/tmp}/trafmgr.XXXXXX" 2>/dev/null) || { TM_TMPDIR=""; return 1; }
  export TMPDIR="$TM_TMPDIR"
  return 0
}
_tm_cleanup() {
  [[ -n ${TM_TMPDIR:-} && -d ${TM_TMPDIR:-} ]] && rm -rf "$TM_TMPDIR" 2>/dev/null
  return 0
}
# 信号处理必须"清理 + 退出"。若只把清理函数挂到 INT/TERM 上, 函数返回后
# shell 会继续执行下一条语句 —— 表现为 Ctrl+C 按不停、systemctl stop 后进程仍在跑,
# 而此时临时目录已被删除, 后续 mktemp 全部失败。
# 退出码遵循 128+信号量 约定 (INT=130, TERM=143), 便于 systemd 正确识别。
_tm_on_int()  { _tm_cleanup; trap - INT;  exit 130; }
_tm_on_term() { _tm_cleanup; trap - TERM; exit 143; }
trap _tm_cleanup EXIT
trap _tm_on_int  INT
trap _tm_on_term TERM
_tm_tmpdir_init

# 清理历史遗留的 mktemp 残片。只清 1 天以上的, 避免误删其它进程正在使用的文件
sweep_stale_tmp() {
  local d
  for d in "$CFG_DIR" "$LIB_DIR" "$STATE_DIR"; do
    [[ -d $d ]] || continue
    find "$d" -maxdepth 1 -type f -name '*.??????' -mmin +1440 -delete 2>/dev/null
  done
  return 0
}

# ---------------------------------------------------------------- 日志
LOG_KEEP_DEFAULT=300
AUDIT_KEEP_DEFAULT=1000
LOG_LEVEL_DEFAULT=INFO

_lvl_n() { case "$1" in DEBUG) echo 0;; INFO) echo 1;; WARN) echo 2;; ERROR) echo 3;; *) echo 1;; esac; }

# 日志裁剪采用"原地截断"而非 mv 换文件: inode 与权限保持不变, 已打开的
# tail -f 不会断流。
# 追加与裁剪必须持同一把锁 —— 若只给裁剪加锁, 在 "tail -n keep > tmp" 与
# "cat tmp > f" 之间写入的日志行会被整体覆盖, 丢的正是最新几行。
_trim_raw() {   # 调用方必须已持有 ${f}.lock
  local f=$1 keep=$2 n tmp
  n=$(wc -l < "$f" 2>/dev/null || echo 0); [[ $n =~ ^[0-9]+$ ]] || n=0
  (( n > keep + 50 )) || return 0
  tmp=$(mktemp "${f}.XXXXXX" 2>/dev/null) || return 0
  # 先落到临时文件, 再原地覆盖写回: inode / 权限 / 已打开的 tail -f 全部保持
  tail -n "$keep" "$f" > "$tmp" 2>/dev/null && cat "$tmp" > "$f" 2>/dev/null
  rm -f "$tmp" 2>/dev/null
  return 0
}
# 追加一行并按需裁剪, 全程持有 ${f}.lock
_log_write() {   # _log_write <文件> <保留行数> <整行内容>
  local f=$1 keep=$2 line=$3 lfd=""
  mkdir -p "$(dirname "$f")" 2>/dev/null
  if command -v flock >/dev/null 2>&1; then
    if exec {lfd}>>"${f}.lock" 2>/dev/null; then
      # 拿不到锁也要把日志写出去: 宁可少裁剪一次, 不能丢记录
      flock -w 5 "$lfd" || { exec {lfd}>&-; lfd=""; }
    else
      lfd=""
    fi
  fi
  printf '%s\n' "$line" >> "$f" 2>/dev/null
  _trim_raw "$f" "$keep"
  [[ -n $lfd ]] && exec {lfd}>&-
  return 0
}
# 独立裁剪入口: 自带取锁, 供不经过 _log_write 的场景调用
_trim_file() {
  local f=$1 keep=$2 lfd=""
  [[ -f $f ]] || return 0
  if command -v flock >/dev/null 2>&1; then
    if exec {lfd}>>"${f}.lock" 2>/dev/null; then
      flock -w 5 "$lfd" || { exec {lfd}>&-; lfd=""; }
    else
      lfd=""
    fi
  fi
  _trim_raw "$f" "$keep"
  [[ -n $lfd ]] && exec {lfd}>&-
  return 0
}

log() {
  local lvl=$1; shift
  local want=${LOG_LEVEL:-$LOG_LEVEL_DEFAULT}
  (( $(_lvl_n "$lvl") < $(_lvl_n "$want") )) && return 0
  _log_write "$LOG" "${LOG_KEEP:-$LOG_KEEP_DEFAULT}" \
    "$(printf '%s [%-5s] [%s] %s' "$(date '+%F %T')" "$lvl" "${LOG_TAG:-main}" "$*")"
}
logd(){ log DEBUG "$@"; }
logi(){ log INFO  "$@"; }
logw(){ log WARN  "$@"; }
loge(){ log ERROR "$@"; }

audit() {
  _log_write "$AUDIT" "${AUDIT_KEEP:-$AUDIT_KEEP_DEFAULT}" \
    "$(printf '%s [%s] %s' "$(date '+%F %T')" "${LOG_TAG:-main}" "$*")"
  log INFO "$*"
}
audit_change() { audit "变更 $1: [$2] -> [$3]${4:+  ($4)}"; }

# ---------------------------------------------------------------- 数值工具 (纯 bash)
# 显示: 真·十进制, 除 1000, 标 B/KB/MB/GB/TB/PB
fmt_bytes() {
  local b=${1:-0} u=0 v rem=0
  local -a U=(B KB MB GB TB PB)
  [[ $b =~ ^-?[0-9]+$ ]] || b=0
  (( b < 0 )) && b=0
  if (( b < 1000 )); then printf '%d B' "$b"; return; fi
  v=$b
  while (( v >= 1000 && u < 5 )); do rem=$(( v % 1000 )); v=$(( v / 1000 )); ((u++)); done
  printf '%d.%02d %s' "$v" "$(( rem / 10 ))" "${U[$u]}"
}

# 位数预检: bash 的 10#$n 对超长数字会静默回绕成负数, 必须在换算前拦下
_digits_ok() { local s=${1:-}; (( ${#s} > 0 && ${#s} <= 18 )); }

# 输入: 不带单位一律按 GB; K/M/G/T/P 为十进制; 显式 KiB/MiB/... 才按 1024
parse_size() {
  local s=${1// /}
  s=$(printf '%s' "$s" | tr '[:lower:]' '[:upper:]')
  [[ -z $s ]] && { echo 0; return 0; }
  [[ $s =~ ^([0-9]+)(\.([0-9]+))?(B|K|KB|KIB|M|MB|MIB|G|GB|GIB|T|TB|TIB|P|PB|PIB)?$ ]] || { echo ERR; return 1; }
  local ip=${BASH_REMATCH[1]} fp=${BASH_REMATCH[3]} un=${BASH_REMATCH[4]:-G} mult=1
  # 必须先查位数再做 10# 转换; 顺序反了等于没有溢出防护
  _digits_ok "$ip" || { echo ERR; return 1; }
  # 前导零会被 bash 当八进制, 08/09 直接报错, 必须用 10# 强制十进制
  ip=$(( 10#$ip ))
  fp="${fp}000"; fp=${fp:0:3}
  case $un in
    B)    mult=1 ;;
    K|KB) mult=1000 ;;          M|MB) mult=$((1000**2)) ;;
    G|GB) mult=$((1000**3)) ;;  T|TB) mult=$((1000**4)) ;;
    P|PB) mult=$((1000**5)) ;;
    KIB)  mult=1024 ;;          MIB)  mult=$((1024**2)) ;;
    GIB)  mult=$((1024**3)) ;;  TIB)  mult=$((1024**4)) ;;
    PIB)  mult=$((1024**5)) ;;
  esac
  # 溢出防护: 整数部分与小数部分分别校验, 相加后再校验一次
  (( ip > 9223372036854775807 / mult )) && { echo ERR; return 1; }
  local ipart=$(( ip * mult ))
  local fpart=$(( (10#$fp * mult) / 1000 ))
  (( ipart > 9223372036854775807 - fpart )) && { echo ERR; return 1; }
  local out=$(( ipart + fpart ))
  (( out < 0 )) && { echo ERR; return 1; }
  echo "$out"
}

# 速率: 输入按十进制比特 (1M = 1000000 bit/s), 输出 nft 的 kbytes (1024 字节) 单位
parse_rate_kbs() {
  local s=${1// /}
  s=$(printf '%s' "$s" | tr '[:upper:]' '[:lower:]'); s=${s%bit}; s=${s%bps}
  [[ $s =~ ^([0-9]+)(k|m|g)?$ ]] || { echo ERR; return 1; }
  local n=${BASH_REMATCH[1]} u=${BASH_REMATCH[2]:-m} bits mul
  # 位数预检必须在 10# 之前, 理由同 parse_size
  _digits_ok "$n" || { echo ERR; return 1; }
  n=$(( 10#$n ))                       # 前导零归一, 避免 08M 被当八进制
  (( n == 0 )) && { echo ERR; return 1; }
  case $u in k) mul=1000;; m) mul=1000000;; g) mul=1000000000;; *) mul=1000000;; esac
  (( n > 9223372036854775807 / mul )) && { echo ERR; return 1; }
  bits=$(( n * mul ))
  local kbs=$(( bits / 8 / 1024 ))
  (( kbs < 1 )) && kbs=1
  echo "$kbs"
}

# 端口号校验: 支持单端口 1-65535 与端口段 a-b
valid_port() {
  local p=$1
  [[ $p =~ [[:space:]] ]] && { PORT_ERR="端口号不能包含空格"; return 1; }
  if [[ $p =~ ^([0-9]{1,5})$ ]]; then
    (( 10#$p >= 1 && 10#$p <= 65535 )) && return 0
    PORT_ERR="端口须在 1-65535 之间"; return 1
  fi
  if [[ $p =~ ^([0-9]{1,5})-([0-9]{1,5})$ ]]; then
    local a=${BASH_REMATCH[1]} b=${BASH_REMATCH[2]}
    (( 10#$a >= 1 && 10#$a <= 65535 )) || { PORT_ERR="起始端口须在 1-65535 之间"; return 1; }
    (( 10#$b >= 1 && 10#$b <= 65535 )) || { PORT_ERR="结束端口须在 1-65535 之间"; return 1; }
    (( 10#$a < 10#$b )) || { PORT_ERR="端口段起始须小于结束"; return 1; }
    return 0
  fi
  PORT_ERR="格式错误, 应为 8443 或 60000-62700"
  return 1
}
# nft 规则生成前的行级校验: 单行坏数据不得拖垮整张表
_port_line_ok() {
  local proto=${1:-} port=${2:-}
  [[ $proto == tcp || $proto == udp ]] || return 1
  valid_port "$port" || return 1
  return 0
}
# 端口 / 端口段 与 SSH 豁免列表是否有交集。必须按数值区间判断:
# 字符串比较会让端口段 20-30 匹配不到 22, 导致 SSH 端口被误限速
port_overlaps_ssh() {
  local p=${1:-} a b sp sa sb
  if [[ $p =~ ^([0-9]{1,5})-([0-9]{1,5})$ ]]; then a=$(( 10#${BASH_REMATCH[1]} )); b=$(( 10#${BASH_REMATCH[2]} ))
  elif [[ $p =~ ^[0-9]{1,5}$ ]]; then a=$(( 10#$p )); b=$a
  else return 1; fi
  for sp in ${RSSH_LIST:-${RSSH:-22}}; do
    if [[ $sp =~ ^([0-9]{1,5})-([0-9]{1,5})$ ]]; then sa=$(( 10#${BASH_REMATCH[1]} )); sb=$(( 10#${BASH_REMATCH[2]} ))
    elif [[ $sp =~ ^[0-9]{1,5}$ ]]; then sa=$(( 10#$sp )); sb=$sa
    else continue; fi
    (( a <= sb && sa <= b )) && return 0
  done
  return 1
}

pct() {
  local a=${1:-0} b=${2:-0}
  [[ $a =~ ^-?[0-9]+$ ]] || a=0
  [[ $b =~ ^-?[0-9]+$ ]] || b=0
  (( b <= 0 )) && { echo 0; return; }
  (( a < 0 )) && a=0
  # a*1000 在 PB 级会溢出 int64。同步右移 a 与 b 保持比值不变, 直到 a*1000 安全为止
  while (( a > 9223372036854775 )); do
    a=$(( a / 1024 )); b=$(( b / 1024 ))
    (( b <= 0 )) && { echo 0; return; }
  done
  echo $(( a * 1000 / b ))
}
pct_str() { local p; p=$(pct "$1" "$2"); printf '%d.%d%%' $(( p / 10 )) $(( p % 10 )); }

bar() {
  local a=${1:-0} b=${2:-0} w=${3:-32} f i out=""
  [[ $a =~ ^-?[0-9]+$ ]] || a=0
  [[ $b =~ ^-?[0-9]+$ ]] || b=0
  (( b <= 0 )) && { printf '%*s' "$w" "" | tr ' ' '-'; return; }
  (( a < 0 )) && a=0
  while (( w > 0 && a > 9223372036854775807 / w )); do
    a=$(( a / 1024 )); b=$(( b / 1024 ))
    (( b <= 0 )) && { printf '%*s' "$w" "" | tr ' ' '-'; return; }
  done
  f=$(( a * w / b ))
  (( f > w )) && f=$w; (( f < 0 )) && f=0
  for ((i=0;i<f;i++)); do out+="#"; done
  for ((i=f;i<w;i++)); do out+="-"; done
  printf '%s' "$out"
}

fmt_dur() {
  local s=${1:-0}
  (( s < 0 )) && s=0
  printf '%d 天 %d 小时 %d 分' $(( s/86400 )) $(( s%86400/3600 )) $(( s%3600/60 ))
}

# ---------------------------------------------------------------- 计费周期
_dim()  { date -d "$1-$2-01 +1 month -1 day" +%d; }
_sday() {
  local rd=$1 dim; dim=$(_dim "$2" "$3")
  if [[ $rd == last ]]; then echo "$dim"
  else (( 10#$rd > 10#$dim )) && echo "$dim" || printf '%02d' "$((10#$rd))"; fi
}
cycle_range() {
  local rd=$1 now=${2:-$(date +%s)} y m d s e
  y=$(date -d "@$now" +%Y); m=$(date -d "@$now" +%m); d=$(date -d "@$now" +%d)
  local sd; sd=$(_sday "$rd" "$y" "$m")
  if (( 10#$d >= 10#$sd )); then
    s=$(date -d "$y-$m-$sd 00:00:00" +%s)
  else
    local py pm psd
    py=$(date -d "$y-$m-01 -1 month" +%Y); pm=$(date -d "$y-$m-01 -1 month" +%m)
    psd=$(_sday "$rd" "$py" "$pm")
    s=$(date -d "$py-$pm-$psd 00:00:00" +%s)
  fi
  local sy sm ny nm nsd
  sy=$(date -d "@$s" +%Y); sm=$(date -d "@$s" +%m)
  ny=$(date -d "$sy-$sm-01 +1 month" +%Y); nm=$(date -d "$sy-$sm-01 +1 month" +%m)
  nsd=$(_sday "$rd" "$ny" "$nm")
  e=$(date -d "$ny-$nm-$nsd 00:00:00" +%s)
  echo "$s $e"
}

# ---------------------------------------------------------------- 探测
SYSNET="${TRAFMGR_SYSNET:-/sys/class/net}"
is_virtual_if() { [[ -e $SYSNET/$1/device ]] && return 1 || return 0; }
if_bytes() { local v; v=$(cat "$SYSNET/$1/statistics/$2_bytes" 2>/dev/null); [[ $v =~ ^[0-9]+$ ]] || v=0; echo "$v"; }

detect_iface() {
  local def best=0 bestif="" i rx tx tot
  def=$(ip route show default 2>/dev/null | awk '/^default/{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
  [[ -z $def ]] && def=$(ip route get 1.1.1.1 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
  for i in $(ls "$SYSNET" 2>/dev/null); do
    [[ $i == lo ]] && continue
    is_virtual_if "$i" && continue
    rx=$(if_bytes "$i" rx); tx=$(if_bytes "$i" tx); tot=$(( rx + tx ))
    (( tot > best )) && { best=$tot; bestif=$i; }
  done
  if [[ -n $def ]] && ! is_virtual_if "$def"; then
    [[ -n $bestif && $bestif != "$def" ]] && logw "网卡探测: 默认路由=$def 但流量最大=$bestif, 采用默认路由"
    echo "$def"; return
  fi
  [[ -n $def ]] && logw "网卡探测: 默认路由 $def 为虚拟接口, 回退物理最大流量 ${bestif:-无}"
  [[ -z $bestif ]] && loge "网卡探测失败: 未找到任何物理网卡 (已排除虚拟接口与 lo)"
  echo "$bestif"
}

# 网卡有效性守卫: 空 / 不存在 / 无统计文件 均视为失败
require_iface() {
  local i=${RIFACE:-}
  if [[ -z $i ]]; then
    loge "网卡未确定, 无法采集。请在菜单 1 -> 2 重新探测, 或在 $CFG 中写死 IFACE"
    IFACE_ERR="未探测到可用物理网卡"
    return 1
  fi
  if [[ ! -d $SYSNET/$i ]]; then
    loge "配置的网卡 $i 不存在。可用: $(ls "$SYSNET" 2>/dev/null | tr '\n' ' ')"
    IFACE_ERR="网卡 $i 不存在"
    return 1
  fi
  if [[ ! -r $SYSNET/$i/statistics/rx_bytes ]]; then
    loge "网卡 $i 统计文件不可读"
    IFACE_ERR="网卡 $i 统计不可读"
    return 1
  fi
  return 0
}

detect_pubip() {
  local i=${1:-} ip
  [[ -z $i ]] && { echo ""; return; }
  ip=$(ip -4 -o addr show dev "$i" 2>/dev/null | awk '{split($4,a,"/"); print a[1]; exit}')
  echo "${ip:-}"
}

# SSH 端口探测: 多源汇总, 宁可多豁免几个也不能漏
# 思路是"保命优先"——豁免一个非 SSH 端口只是少限速一点, 漏掉真 SSH 端口会直接失联
detect_ssh_ports() {
  local out; out=$(mktemp)
  # 源1 sshd -T 运行时有效配置 (最权威, 可能多个 Port)
  sshd -T 2>/dev/null | awk '/^port /{print $2}' >> "$out"
  # 源2 主配置文件
  awk '/^[[:space:]]*Port[[:space:]]+[0-9]+/{print $2}' /etc/ssh/sshd_config 2>/dev/null >> "$out"
  # 源3 include 的子配置 (Debian 12 默认 /etc/ssh/sshd_config.d/*.conf)
  awk '/^[[:space:]]*Port[[:space:]]+[0-9]+/{print $2}' /etc/ssh/sshd_config.d/*.conf 2>/dev/null >> "$out"
  # 源4 实际监听: 取 sshd 进程占用的非回环端口
  # IPv6 地址按 : 拆分后需补回冒号, 否则 [::1] 会被拼成 [1], 回环判定失效
  ss -tlnpH 2>/dev/null | awk '/sshd/{
    l=""; for(i=1;i<=NF;i++){ if($i ~ /^users:/) continue; if($i ~ /:[0-9]+$/){ l=$i; break } }
    if(l==""){next}
    n=split(l,a,":"); port=a[n]; ad=""
    for(i=1;i<n;i++) ad = ad a[i] (i<n-1?":":"")
    if(ad=="127.0.0.1"||ad=="[::1]"||ad=="::1"||ad ~ /^127\./) next
    print port }' >> "$out"
  # 源5 systemd socket 激活 (ssh.socket)
  systemctl show ssh.socket sshd.socket -p Listen 2>/dev/null \
    | grep -oE '[0-9]+ ' | tr -d ' ' >> "$out"
  # 源6 当前 SSH 会话的服务端端口 (你正连着的那个, 最不该漏)
  if [[ -n ${SSH_CONNECTION:-} ]]; then
    printf '%s\n' "$(printf '%s' "$SSH_CONNECTION" | awk '{print $4}')" >> "$out"
  fi
  # 去重 + 合法性过滤
  local list; list=$(awk '/^[0-9]+$/ && $1>=1 && $1<=65535' "$out" | sort -un | tr '\n' ' ')
  rm -f "$out"
  list=${list% }
  if [[ -z $list ]]; then
    list=22
    logw "SSH 端口探测失败, 回退 22 (限速将只豁免 22)"
  fi
  echo "$list"
}
# 首选端口 (用于显示): 优先取 sshd -T 权威值, 否则取豁免列表首个
detect_ssh_port() {
  local p
  p=$(sshd -T 2>/dev/null | awk '/^port /{print $2; exit}')
  [[ $p =~ ^[0-9]+$ ]] || p=$(awk '/^[[:space:]]*Port[[:space:]]+[0-9]+/{print $2; exit}' /etc/ssh/sshd_config 2>/dev/null)
  [[ $p =~ ^[0-9]+$ ]] || p=$(detect_ssh_ports | awk '{print $1}')
  [[ $p =~ ^[0-9]+$ ]] || p=22
  echo "$p"
}

discover_listen() {
  ss -tulnpH 2>/dev/null | awk '
    { proto=($1=="tcp"||$1=="udp")?$1:"tcp"; l=""
      for(i=1;i<=NF;i++){ if($i ~ /^users:/) continue; if($i ~ /:[0-9]+$/){ l=$i; break } }
      if(l==""){next}
      n=split(l,a,":"); port=a[n]; ad=""
      for(i=1;i<n;i++) ad = ad a[i] (i<n-1?":":"")
      if(ad=="") ad="*"
      if(ad=="127.0.0.1"||ad=="[::1]"||ad=="::1"||ad ~ /^127\./) next
      svc=""; if(match($0,/users:\(\("[^"]+/)) svc=substr($0,RSTART+9,RLENGTH-9)
      print proto"\t"port"\t"(svc==""?"-":svc) }' | sort -u -t$'\t' -k1,1 -k2,2
}

# 只解析 type nat 链内的规则。其它表里含 "redirect to ..." 字样的 comment
# 会被误识别成跳跃端口, 而 kind 判错会让限速挂到错误的链上 (redir 走
# input/output, fwd 走 forward), 表现为"限速不生效"
discover_nat() {
  nft list ruleset 2>/dev/null | awk '
    # --- 表 / 链上下文跟踪 ---
    /^[[:space:]]*table[[:space:]]/ { intable=1; isnat=0; depth=0 }
    /^[[:space:]]*chain[[:space:]]/ { inchain=1 }
    # chain 声明里出现 type nat 才认为是 NAT 链
    /type[[:space:]]+nat[[:space:]]+hook/ { isnat=1 }
    /^[[:space:]]*}/ { if (inchain) { inchain=0; isnat=0 } }
    /^[[:space:]]*#/ {next}
    {
      if (!isnat) next                     # 只解析 NAT 链内的规则
      line=$0
      # --- 动作与目标 ---
      kind=""; tgt=""
      if (match(line,/dnat[[:space:]]+(ip6?[[:space:]]+)?to[[:space:]]+[^[:space:],;}]+/)) {
        kind="fwd"; s=substr(line,RSTART,RLENGTH)
        sub(/^dnat[[:space:]]+(ip6?[[:space:]]+)?to[[:space:]]+/,"",s); tgt=s
      } else if (match(line,/redirect[[:space:]]+to[[:space:]]+[^[:space:],;}]+/)) {
        kind="redir"; s=substr(line,RSTART,RLENGTH)
        sub(/^redirect[[:space:]]+to[[:space:]]+/,"",s); tgt=s
      } else if (line ~ /[[:space:]]redirect([[:space:]]|$)/) {
        kind="redir"; tgt="-"
      }
      if (kind=="") next

      # --- 协议 ---
      proto=""
      if (match(line,/(^|[[:space:]])(tcp|udp)[[:space:]]+dport/)) {
        s=substr(line,RSTART,RLENGTH); if (s ~ /tcp/) proto="tcp"; else proto="udp"
      } else if (match(line,/(meta[[:space:]]+l4proto|ip[[:space:]]+protocol)[[:space:]]+(tcp|udp)/)) {
        s=substr(line,RSTART,RLENGTH); if (s ~ /tcp/) proto="tcp"; else proto="udp"
      }
      if (proto=="") next

      # --- 端口: 支持 单个 / 区间 / {a,b,c} 集合 ---
      if (!match(line,/dport[[:space:]]+/)) next
      rest=substr(line,RSTART+RLENGTH)
      sub(/^[[:space:]]+/,"",rest)
      if (substr(rest,1,1)=="@") next            # 命名集合, 无法静态解析
      if (substr(rest,1,1)=="{") {
        e=index(rest,"}"); if(e==0) next
        setstr=substr(rest,2,e-2)
        gsub(/[[:space:]]/,"",setstr)
        n=split(setstr,arr,",")
        for(j=1;j<=n;j++){ if(arr[j]!="") print proto"\t"arr[j]"\t"kind"\t"(tgt==""?"-":tgt) }
        next
      }
      if (match(rest,/^[0-9]+(-[0-9]+)?/)) {
        port=substr(rest,RSTART,RLENGTH)
        print proto"\t"port"\t"kind"\t"(tgt==""?"-":tgt)
      }
    }' | sed 's/\t:/\t/' | awk -F'\t' 'BEGIN{OFS="\t"} {sub(/^:/,"",$4); print}' \
    | sort -u -t$'\t' -k1,1 -k2,2
}

# ---------------------------------------------------------------- 配置
cfg_defaults() {
  IFACE=auto; PUBLIC_IP=auto; SSH_PORT=auto
  RESET_DAY=1; QUOTA=0; QUOTA_BASIS=total
  COLLECT_INTERVAL=5; AUTO_DISCOVER=1; COUNT_FORWARD=1
  ENFORCE_HOST=0; ENFORCE_HOST_AT=100; ENFORCE_HOST_RATE=1M
  ENFORCE_PORT=0; ENFORCE_PORT_RATE=1M; PQUOTA_BASIS=total; RESET_CLEAR_LIMITS=1
  STALE_KEEP_DAYS=30
  NFT_TABLE=$NFT_TABLE_DEFAULT
  LOG_LEVEL=$LOG_LEVEL_DEFAULT; LOG_KEEP=$LOG_KEEP_DEFAULT; AUDIT_KEEP=$AUDIT_KEEP_DEFAULT
}
# 只接受白名单键与安全字符, 避免配置文件被写入任意命令
cfg_read() {
  [[ -f $CFG ]] || return 0
  local line k v
  while IFS= read -r line; do
    [[ -z $line || $line == \#* ]] && continue
    [[ $line == *=* ]] || continue
    k=${line%%=*}; v=${line#*=}
    k=${k//[[:space:]]/}
    v=${v%\"}; v=${v#\"}; v=${v%\'}; v=${v#\'}
    [[ $v =~ ^[A-Za-z0-9._/:+,-]*$ ]] || { logw "配置项 $k 含非法字符, 已忽略"; continue; }
    case $k in
      IFACE|PUBLIC_IP|SSH_PORT|RESET_DAY|QUOTA|QUOTA_BASIS|COLLECT_INTERVAL|\
      AUTO_DISCOVER|COUNT_FORWARD|ENFORCE_HOST|ENFORCE_HOST_AT|ENFORCE_HOST_RATE|\
      ENFORCE_PORT|ENFORCE_PORT_RATE|PQUOTA_BASIS|RESET_CLEAR_LIMITS|STALE_KEEP_DAYS|NFT_TABLE|\
      LOG_LEVEL|LOG_KEEP|AUDIT_KEEP)
        printf -v "$k" '%s' "$v" ;;
      *) logw "未知配置项 $k, 已忽略" ;;
    esac
  done < "$CFG"
  # 数值型统一去前导零(10#), 否则 08 / 09 会触发 "value too great for base" 报错
  local _nv _cur
  for _nv in QUOTA COLLECT_INTERVAL ENFORCE_HOST_AT STALE_KEEP_DAYS LOG_KEEP AUDIT_KEEP; do
    _cur=$(eval "printf '%s' \"\${$_nv:-}\"")
    if [[ $_cur =~ ^[0-9]+$ ]] && _digits_ok "$_cur"; then
      printf -v "$_nv" '%s' "$(( 10#$_cur ))"
    fi
  done
  [[ $RESET_DAY == last ]] || { [[ $RESET_DAY =~ ^[0-9]+$ ]] && RESET_DAY=$(( 10#$RESET_DAY )); }
  [[ $RESET_DAY == last || $RESET_DAY =~ ^([1-9]|1[0-9]|2[0-8])$ ]] || RESET_DAY=1
  [[ $QUOTA =~ ^[0-9]+$ ]] || QUOTA=0
  [[ $COLLECT_INTERVAL =~ ^[0-9]+$ ]] && (( COLLECT_INTERVAL >= 1 )) || COLLECT_INTERVAL=5
  [[ $ENFORCE_HOST_AT =~ ^[0-9]+$ ]] || ENFORCE_HOST_AT=100
  [[ $STALE_KEEP_DAYS =~ ^[0-9]+$ ]] || STALE_KEEP_DAYS=30
  [[ $LOG_KEEP =~ ^[0-9]+$ ]] && (( LOG_KEEP >= 50 )) || LOG_KEEP=300
  [[ $AUDIT_KEEP =~ ^[0-9]+$ ]] && (( AUDIT_KEEP >= 50 )) || AUDIT_KEEP=1000
  # 表名非法会导致 nft 操作误伤其它表, 必须回落默认
  if ! nft_table_name_ok "${NFT_TABLE:-}"; then
    [[ -n ${NFT_TABLE:-} ]] && logw "配置项 NFT_TABLE 值非法 [$NFT_TABLE], 已回落默认 $NFT_TABLE_DEFAULT"
    NFT_TABLE=$NFT_TABLE_DEFAULT
  fi
  case $QUOTA_BASIS in up|down|total|max) ;; *) QUOTA_BASIS=total ;; esac
  case $PQUOTA_BASIS in up|down|total|max) ;; *) PQUOTA_BASIS=total ;; esac
  case $LOG_LEVEL in DEBUG|INFO|WARN|ERROR) ;; *) LOG_LEVEL=INFO ;; esac
  # 布尔项非法时回落到"各自的出厂默认", 不能一律归 0
  # 尤其 RESET_CLEAR_LIMITS 归 0 会导致超额限速永久卡死
  local b bd cur
  for b in AUTO_DISCOVER:1 COUNT_FORWARD:1 ENFORCE_HOST:0 ENFORCE_PORT:0 RESET_CLEAR_LIMITS:1; do
    bd=${b#*:}; b=${b%%:*}
    cur=$(eval "printf '%s' \"\${$b:-}\"")
    if [[ ! $cur =~ ^[01]$ ]]; then
      [[ -n $cur ]] && logw "配置项 $b 值非法 [$cur], 已回落默认 $bd"
      printf -v "$b" '%s' "$bd"
    fi
  done
}

# SSH / 网卡探测结果缓存。主菜单每次重绘都会 cfg_load, 若每轮都重跑
# sshd -T + ss + systemctl, 在慢速 VPS 上会有肉眼可见的顿挫
SSH_CACHE_TTL=${TRAFMGR_SSH_TTL:-300}
_ssh_cache_load() {
  local f="$STATE_DIR/ssh.cache" mt now
  [[ -f $f ]] || return 1
  mt=$(stat -c %Y "$f" 2>/dev/null) || return 1
  now=$(date +%s)
  (( now - mt < SSH_CACHE_TTL )) || return 1
  local l1 l2
  { IFS= read -r l1; IFS= read -r l2; } < "$f"
  [[ -n ${l1:-} ]] || return 1
  RSSH_LIST=$l1; RSSH=${l2:-22}
  return 0
}
_ssh_cache_save() {
  mkdir -p "$STATE_DIR" 2>/dev/null
  printf '%s\n%s\n' "${RSSH_LIST:-22}" "${RSSH:-22}" > "$STATE_DIR/ssh.cache" 2>/dev/null
  return 0
}
ssh_cache_flush() { rm -f "$STATE_DIR/ssh.cache" 2>/dev/null; return 0; }

cfg_load() {
  cfg_defaults
  cfg_read
  RIFACE=$IFACE;  [[ $IFACE   == auto ]] && RIFACE=$(detect_iface)
  if ! _ssh_cache_load; then
    if [[ $SSH_PORT == auto ]]; then
      RSSH_LIST=$(detect_ssh_ports)
      RSSH=$(detect_ssh_port)
    else
      # 手动指定: 以手写为准, 但仍并入自动探测结果 (只增不减, 避免漏豁免导致失联)
      local _man="${SSH_PORT//,/ }"
      RSSH_LIST=$(printf '%s %s\n' "$_man" "$(detect_ssh_ports)" | tr ' ' '\n' \
        | awk '/^[0-9]+$/ && $1>=1 && $1<=65535' | sort -un | tr '\n' ' ')
      RSSH_LIST=${RSSH_LIST% }
      RSSH=$(printf '%s' "$_man" | awk '{print $1}')
    fi
    [[ -n ${RSSH_LIST:-} ]] || RSSH_LIST=22
    [[ $RSSH =~ ^[0-9]+$ ]] || RSSH=22
    _ssh_cache_save
  fi
  RIP=$PUBLIC_IP; [[ $PUBLIC_IP == auto ]] && RIP=$(detect_pubip "$RIFACE")
}
# 保存失败必须让调用方知道: 否则内存值已改、审计已记"成功", 重启后却回滚
cfg_save() {
  mkdir -p "$CFG_DIR" || { loge "无法创建配置目录 $CFG_DIR"; return 1; }
  local _cfgtmp; _cfgtmp=$(mktemp "${CFG}.XXXXXX") || { loge "无法创建配置临时文件"; return 1; }
  if ! cat > "$_cfgtmp" <<EOF
# trafmgr 配置  v$VERSION   auto = 运行时自动探测
# SSH_PORT 可写 auto, 或逗号分隔多个端口如 22,22123 (仍会并入自动探测结果)
# QUOTA 为字节数, 十进制口径 (1GB = 1000000000 字节)
IFACE=$IFACE
PUBLIC_IP=$PUBLIC_IP
SSH_PORT=$SSH_PORT
RESET_DAY=$RESET_DAY
QUOTA=$QUOTA
QUOTA_BASIS=$QUOTA_BASIS
COLLECT_INTERVAL=$COLLECT_INTERVAL
AUTO_DISCOVER=$AUTO_DISCOVER
COUNT_FORWARD=$COUNT_FORWARD
ENFORCE_HOST=$ENFORCE_HOST
ENFORCE_HOST_AT=$ENFORCE_HOST_AT
ENFORCE_HOST_RATE=$ENFORCE_HOST_RATE
ENFORCE_PORT=$ENFORCE_PORT
ENFORCE_PORT_RATE=$ENFORCE_PORT_RATE
PQUOTA_BASIS=$PQUOTA_BASIS
RESET_CLEAR_LIMITS=$RESET_CLEAR_LIMITS
STALE_KEEP_DAYS=$STALE_KEEP_DAYS
NFT_TABLE=$NFT_TABLE
LOG_LEVEL=$LOG_LEVEL
LOG_KEEP=$LOG_KEEP
AUDIT_KEEP=$AUDIT_KEEP
EOF
  then
    loge "配置写入失败 (磁盘满或只读挂载?) $CFG"
    rm -f "$_cfgtmp" 2>/dev/null
    return 1
  fi
  chmod 600 "$_cfgtmp" 2>/dev/null
  if ! mv -f "$_cfgtmp" "$CFG"; then
    loge "配置替换失败 $CFG"
    rm -f "$_cfgtmp" 2>/dev/null
    return 1
  fi
  return 0
}
# cfg_save 失败时回滚内存值并如实报错, 绝不记成功审计
cfg_set() {
  local k=$1 nv=$2 ov
  ov=$(eval "printf '%s' \"\${$k:-}\"")
  [[ $ov == "$nv" ]] && return 0
  eval "$k=\$nv"
  if ! cfg_save; then
    eval "$k=\$ov"
    loge "配置项 $k 保存失败, 已回滚内存值为 [$ov]"
    printf '  %s配置保存失败 (磁盘满 / 只读挂载?), 修改未生效%s\n' "${C_E:-}" "${C_R:-}" >&2
    return 1
  fi
  audit_change "$k" "$ov" "$nv"
  return 0
}

# ---------------------------------------------------------------- TSV 状态
# ports.tsv : key \t proto \t port \t kind \t note \t src \t first_seen \t state \t last_seen
# cycle/life: key \t up \t down
# pquota    : key \t bytes
# ---------------------------------------------------------------- 并发保护
# systemd timer 采集与交互菜单可能同时写同一批 TSV, 必须加锁
LOCK_DIR="${LIB_DIR}/.lock"
# 有无 flock 两条分支都放进子 shell, 保证执行上下文一致。
# 否则变量赋值与 exit 的行为在两种环境下不同, 是很隐蔽的踩坑点
with_lock() {   # with_lock <文件> <命令...>
  local target=$1; shift
  local lf="${LOCK_DIR}/$(printf '%s' "$target" | tr '/' '_').lock"
  mkdir -p "$LOCK_DIR" 2>/dev/null
  if command -v flock >/dev/null 2>&1; then
    ( flock -w 10 9 || { loge "获取锁超时: $target"; exit 1; }
      "$@" ) 9>"$lf"
    return $?
  fi
  # 无 flock 时退化为 mkdir 原子锁, 同样在子 shell 中执行
  local d="${lf}.d" i=0
  while ! mkdir "$d" 2>/dev/null; do
    i=$(( i + 1 )); (( i > 100 )) && { loge "获取锁超时: $target"; return 1; }
    sleep 0.1
  done
  ( "$@" ); local rc=$?
  rmdir "$d" 2>/dev/null
  return $rc
}

# 采集锁。所有会重建 nft 表的路径都必须经由此函数取锁,
# 否则菜单操作与定时器采集并发时会丢一轮端口计数
COLLECT_LOCK_FILE="$LIB_DIR/.collect.lock"
with_collect_lock() {   # with_collect_lock <命令...>
  mkdir -p "$LIB_DIR" 2>/dev/null
  if ! command -v flock >/dev/null 2>&1; then "$@"; return $?; fi
  local rc
  ( flock -w 30 8 || { loge "获取采集锁超时"; exit 1; }
    "$@" ) 8>"$COLLECT_LOCK_FILE"
  rc=$?
  return $rc
}

nlines() { local n; n=$(grep -c . "$1" 2>/dev/null); [[ $n =~ ^[0-9]+$ ]] || n=0; echo "$n"; }
# 清空文件必须走锁, 否则可能与采集端的读-改-写交错, 导致刚写入的数据被覆盖
_truncate_raw() { : > "$1"; }
tsv_truncate() { with_lock "$1" _truncate_raw "$1"; }
# 原子写文件: 先写临时文件再 mv, 避免读方看到写了一半的内容
# 每一步都检查返回值: 静默失败会让上层误判为写入成功
atomic_write() {   # atomic_write <目标> [源文件]
  local f=$1 srcf=${2:-}
  mkdir -p "$(dirname "$f")" 2>/dev/null || { loge "atomic_write: 无法创建目录 $(dirname "$f")"; return 1; }
  local tmp; tmp=$(mktemp "${f}.XXXXXX") || { loge "atomic_write: mktemp 失败 $f"; return 1; }
  if [[ -n $srcf ]]; then
    cat "$srcf" > "$tmp" || { loge "atomic_write: 写入失败 $f"; rm -f "$tmp"; return 1; }
  else
    cat > "$tmp" || { loge "atomic_write: 写入失败 $f"; rm -f "$tmp"; return 1; }
  fi
  chmod 600 "$tmp" 2>/dev/null
  mv -f "$tmp" "$f" || { loge "atomic_write: 替换失败 $f"; rm -f "$tmp"; return 1; }
  return 0
}
tsv_get() { awk -F'\t' -v k="$1" '$1==k{print; exit}' "$2" 2>/dev/null; }
# 字段消毒: TSV 以 tab 分隔, 值内不得含 tab / 换行
tsv_clean() { printf '%s' "${1//[$'\t\n\r']/ }"; }
_tsv_put_raw() {
  local f=$1 k=$2; shift 2
  local a rest=""
  for a in "$@"; do rest+="$(tsv_clean "$a")"$'\t'; done
  rest=${rest%$'\t'}
  k=$(tsv_clean "$k")
  mkdir -p "$(dirname "$f")" || return 1
  touch "$f" || return 1
  local tmp; tmp=$(mktemp "${f}.XXXXXX") || { loge "tsv_put: mktemp 失败 $f"; return 1; }
  awk -F'\t' -v k="$k" '$1!=k{print}' "$f" > "$tmp" 2>/dev/null
  printf '%s\t%s\n' "$k" "$rest" >> "$tmp" || { rm -f "$tmp"; return 1; }
  mv -f "$tmp" "$f" || { loge "tsv_put: 替换失败 $f"; rm -f "$tmp"; return 1; }
  return 0
}
# 失败时明确报错, 不静默吞掉
tsv_put() {
  local f=$1; shift
  if ! with_lock "$f" _tsv_put_raw "$f" "$@"; then
    loge "写入失败: $f (键=${1:-})"
    return 1
  fi
  return 0
}
_tsv_del_raw() {
  local f=$1 k=$2
  [[ -f $f ]] || return 0
  local tmp; tmp=$(mktemp "${f}.XXXXXX") || return 1
  awk -F'\t' -v k="$k" '$1!=k{print}' "$f" > "$tmp" && mv -f "$tmp" "$f" || { rm -f "$tmp"; return 1; }
  return 0
}
tsv_del() { local f=$1; shift; with_lock "$f" _tsv_del_raw "$f" "$@"; }
_acc_add_raw() {
  local f=$1 k=$2 du=$3 dd=$4 line u=0 d=0
  mkdir -p "$(dirname "$f")"; touch "$f"
  line=$(tsv_get "$k" "$f")
  if [[ -n $line ]]; then
    u=$(printf '%s' "$line" | cut -f2); d=$(printf '%s' "$line" | cut -f3)
  fi
  [[ $u =~ ^[0-9]+$ ]] || u=0; [[ $d =~ ^[0-9]+$ ]] || d=0
  _tsv_put_raw "$f" "$k" "$(( u + du ))" "$(( d + dd ))"
}
# 读-改-写必须整体加锁, 否则并发下丢更新
acc_add() { local f=$1; shift; with_lock "$f" _acc_add_raw "$f" "$@"; }
acc_get() {   # $1=键 $2=文件 -> "up down"
  local line u d
  line=$(tsv_get "$1" "$2")
  u=$(printf '%s' "$line" | cut -f2); d=$(printf '%s' "$line" | cut -f3)
  [[ $u =~ ^[0-9]+$ ]] || u=0; [[ $d =~ ^[0-9]+$ ]] || d=0
  echo "$u $d"
}
_snap_delta_raw() {
  local k=$1 cur=$2 prev d
  mkdir -p "$(dirname "$SNAP")"; touch "$SNAP"
  prev=$(awk -F'\t' -v k="$k" '$1==k{print $2; exit}' "$SNAP")
  [[ $prev =~ ^[0-9]+$ ]] || prev=""
  if [[ -z $prev ]]; then d=0
  elif (( cur >= prev )); then d=$(( cur - prev ))
  else d=$cur; logw "计数器归零 $k: 上次=$prev 当前=$cur, 按当前值计入"; fi
  local tmp; tmp=$(mktemp "${SNAP}.XXXXXX") || return 1
  awk -F'\t' -v k="$k" -v v="$cur" 'BEGIN{OFS="\t"} $1!=k{print} END{print k,v}' "$SNAP" > "$tmp" && mv -f "$tmp" "$SNAP"
  echo "$d"
}
snap_delta() {
  local k=$1 cur=$2
  [[ $cur =~ ^[0-9]+$ ]] || cur=0
  with_lock "$SNAP" _snap_delta_raw "$k" "$cur"
}
# 重建 nft 表后必须清掉端口计数基线, 否则新表从 0 开始会被当成"计数器归零"
_snap_drop_ports_raw() {
  [[ -f $SNAP ]] || return 0
  local tmp; tmp=$(mktemp "${SNAP}.XXXXXX") || return 1
  awk -F'\t' '$1 !~ /^p_/{print}' "$SNAP" > "$tmp" && mv -f "$tmp" "$SNAP"
  logd "已清除端口计数基线 (nft 表重建)"
}
snap_drop_ports() { with_lock "$SNAP" _snap_drop_ports_raw; }

# ---------------------------------------------------------------- nft 计数表
nft_ok() { command -v nft >/dev/null 2>&1; }
pkey() { printf '%s/%s' "$2" "$1"; }

# --- 表安全: 绝不能误删用户已有的 nft 表 ---
# 归属标记采用"空标记链"。chain 级 comment 需 nftables 1.0.3+, 在
# Debian 11 (0.9.8) / Ubuntu 20.04 (0.9.3) 上会直接语法报错导致建表失败。
# 空链所有版本均支持, 不挂 hook 就不处理任何报文, 零开销。
NFT_MARK_CHAIN="trafmgr_owned_marker"
# 旧版 (<=1.6.x) 使用的注释标记, 仅用于向后识别
NFT_MARK_LEGACY="trafmgr-owned-do-not-edit"
# 更早版本的表既无标记链也无注释, 用本脚本自有的链名作为兜底识别特征
NFT_OWN_CHAINS='local_in|local_out|fwd_in|fwd_out|lim_in|lim_out|lim_fwd|enf_in|enf_out|enf_fwd'

# 表名白名单: 只允许字母数字下划线, 且不得与常见系统表重名
# 表名校验拆成两个函数, 不要合并:
#   基础名受 27 字符限制, 是为派生的 _lim / _enf (4 字符) 留出余量;
#   派生名若再套用同一上限, 等于把余量重复扣两次 —— 基础名 24-27 字符时
#   自身通过、${t}_lim 却被拒, 结果是计数表能建而限速表与超额表建不了。
# 派生名只做字符集与保留名校验, 长度按内核实际上限 (nftables 表名 <=255)。
_nft_name_charset_ok() {
  local t=$1
  [[ $t =~ ^[A-Za-z_][A-Za-z0-9_]{0,254}$ ]] || return 1
  case $t in
    filter|nat|mangle|raw|security|inet|ip|ip6|bridge|arp|netdev) return 1 ;;
  esac
  return 0
}
# 基础表名: 长度 <=27, 为 _lim / _enf 留余量
nft_table_name_ok() {
  local t=$1
  (( ${#t} <= 27 )) || return 1
  _nft_name_charset_ok "$t"
}
# 派生表名 (${base}_lim / ${base}_enf): 只做字符集与保留名校验, 长度不再受 27 限制
nft_derived_name_ok() { _nft_name_charset_ok "${1:-}"; }

# 必须区分"表不存在"与"命令执行失败": 前者可安全接管, 后者一律拒绝操作
# 返回 0=可安全操作(不存在或确属我方)  1=属于他人  2=无法判定(命令失败)
nft_table_is_ours() {
  local t=$1 out rc
  if ! nft list tables inet >/dev/null 2>&1; then
    loge "nft 不可用或权限不足, 无法判定表归属"
    return 2
  fi
  if ! nft list tables inet 2>/dev/null | grep -qE "^table inet ${t}\$"; then
    return 0    # 表不存在 -> 可安全创建
  fi
  out=$(nft list table inet "$t" 2>/dev/null); rc=$?
  if (( rc != 0 )); then
    loge "读取 inet $t 失败 (rc=$rc), 出于安全拒绝操作"
    return 2
  fi
  [[ -z $out ]] && return 2
  # 新版标记: 空标记链
  printf '%s' "$out" | grep -qE "chain[[:space:]]+${NFT_MARK_CHAIN}[[:space:]]*\{" && return 0
  # 旧版标记: 注释字符串
  printf '%s' "$out" | grep -q "$NFT_MARK_LEGACY" && return 0
  # 兜底: 命中本脚本自有链名即视为自有 (更早版本的表没有任何标记)
  if printf '%s' "$out" | grep -qE "chain[[:space:]]+(${NFT_OWN_CHAINS})[[:space:]]*\{"; then
    logw "inet $t 无归属标记但链结构匹配 trafmgr, 判定为自有 (旧版本遗留), 将在重建时补写标记"
    return 0
  fi
  return 1
}
# 建表/删表前统一守卫: 名字非法 / 表属于别人 / 无法判定 -> 一律拒绝操作
nft_guard_table() {
  local t=$1 who=${2:-操作} rc
  # 派生表 (_lim/_enf) 走宽松校验, 避免基础名合法却卡住派生表
  local _nameok=0
  case $t in
    *_lim|*_enf) nft_derived_name_ok "$t" && _nameok=1 ;;
    *)           nft_table_name_ok  "$t" && _nameok=1 ;;
  esac
  if (( _nameok == 0 )); then
    loge "$who 中止: 表名 [$t] 非法或与系统保留名冲突"
    NFT_GUARD_ERR="表名 [$t] 非法, 只允许字母数字下划线, 长度<=27, 且不得为 filter/nat/mangle 等保留名"
    return 1
  fi
  nft_table_is_ours "$t"; rc=$?
  if (( rc == 1 )); then
    loge "$who 中止: inet $t 已存在且非 trafmgr 创建, 拒绝覆盖以免误删用户规则"
    NFT_GUARD_ERR="inet $t 已存在且不属于 trafmgr, 请在 $CFG 中改用其它 NFT_TABLE 名"
    return 1
  fi
  if (( rc == 2 )); then
    loge "$who 中止: 无法确认 inet $t 归属 (nft 执行失败), 出于安全不做任何修改"
    NFT_GUARD_ERR="无法确认 inet $t 归属, nft 执行失败。请检查 nft 是否可用及权限"
    return 1
  fi
  return 0
}
# 仅删除确属 trafmgr 的表
nft_delete_own_table() {
  local t=$1 rc
  nft list table inet "$t" >/dev/null 2>&1 || return 0
  nft_table_is_ours "$t"; rc=$?
  if (( rc == 0 )); then
    if nft delete table inet "$t" 2>>"$LOG"; then return 0; fi
    loge "删除 inet $t 失败"
    return 1
  fi
  (( rc == 1 )) && logw "跳过删除 inet $t: 该表非 trafmgr 创建"
  (( rc == 2 )) && loge "跳过删除 inet $t: 无法确认归属"
  return 1
}
# 表是否存在 (供状态判定使用)
nft_table_exists() { nft list table inet "$1" >/dev/null 2>&1; }

# 端口清单指纹必须纳入 COUNT_FORWARD 与 NFT_TABLE:
# 否则改这两项不会触发重建, 转发计数链不增删, 表现为"开关拨了没反应"
ports_fingerprint() {
  { awk -F'\t' '$8!="gone"{print $2"|"$3"|"$4}' "$PORTS" 2>/dev/null | sort
    printf 'CF=%s\nTB=%s\n' "${COUNT_FORWARD:-1}" "${NFT_TABLE:-$NFT_TABLE_DEFAULT}"
  } | cksum | awk '{print $1"_"$2}'
}

# 记录上一次生效的表名。改名时先清掉旧表, 否则旧的 _lim/_enf 会成为无人
# 管理的孤儿表, 继续在内核里丢包, 且卸载流程按新名清理时删不掉它们
TABLE_STATE="$STATE_DIR/table.name"
nft_sync_table_rename() {
  local cur=${NFT_TABLE:-$NFT_TABLE_DEFAULT} old tb
  mkdir -p "$STATE_DIR" 2>/dev/null
  old=$(cat "$TABLE_STATE" 2>/dev/null)
  if [[ -n ${old:-} && $old != "$cur" ]]; then
    audit "检测到 NFT_TABLE 改名: $old -> $cur, 清理旧表"
    for tb in "$old" "${old}_lim" "${old}_enf"; do
      if nft_table_exists "$tb"; then
        if nft_delete_own_table "$tb"; then audit "已移除旧表 inet $tb"
        else logw "旧表 inet $tb 未能移除 (非我方或删除失败), 请手动检查"; fi
      fi
    done
  fi
  printf '%s\n' "$cur" > "$TABLE_STATE" 2>/dev/null
  return 0
}

nft_build() {
  local t=${NFT_TABLE:-$NFT_TABLE_DEFAULT}
  nft_ok || { loge "未找到 nft, 无法建立端口计数"; return 1; }
  nft_sync_table_rename
  nft_guard_table "$t" "建立计数表" || return 1
  local tmp; tmp=$(mktemp) || return 1
  local nbad=0 nok=0
  {
    # 原子替换: 声明->删除->重建 全部在同一 nft 事务内, 无空窗期
    echo "table inet $t"
    echo "delete table inet $t"
    echo "table inet $t {"
    # 空标记链: 不挂 hook, 不处理任何报文, 全版本兼容
    echo "  chain $NFT_MARK_CHAIN { }"
    echo "  chain local_in  { type filter hook input       priority -150; policy accept;"
    echo "    iif lo return"      # 回环流量不消耗网卡带宽, 不计入端口统计
    while IFS=$'\t' read -r _k proto port kind note src first state last; do
      [[ -z ${_k:-} || ${_k} == \#* ]] && continue
      [[ ${state:-live} == gone ]] && continue
      [[ $kind == local ]] || continue
      # 坏行跳过并告警, 不让单行拖垮整表
      _port_line_ok "$proto" "$port" || { nbad=$(( nbad + 1 )); continue; }
      echo "    $proto dport $port counter comment \"tmL_${port}_${proto}\""
    done < <(cat "$PORTS" 2>/dev/null)
    echo "  }"
    echo "  chain local_out { type filter hook output      priority -150; policy accept;"
    echo "    oif lo return"
    while IFS=$'\t' read -r _k proto port kind note src first state last; do
      [[ -z ${_k:-} || ${_k} == \#* ]] && continue
      [[ ${state:-live} == gone ]] && continue
      [[ $kind == local ]] || continue
      _port_line_ok "$proto" "$port" || continue
      echo "    $proto sport $port counter comment \"tmL_${port}_${proto}\""
    done < <(cat "$PORTS" 2>/dev/null)
    echo "  }"
    if [[ ${COUNT_FORWARD:-1} == 1 ]]; then
      echo "  chain fwd_in    { type filter hook prerouting  priority -300; policy accept;"
      echo "    iif lo return"
      while IFS=$'\t' read -r _k proto port kind note src first state last; do
        [[ -z ${_k:-} || ${_k} == \#* ]] && continue
        [[ ${state:-live} == gone ]] && continue
        [[ $kind == fwd || $kind == redir ]] || continue
        _port_line_ok "$proto" "$port" || { nbad=$(( nbad + 1 )); continue; }
        echo "    $proto dport $port counter comment \"tmF_${port}_${proto}\""
      done < <(cat "$PORTS" 2>/dev/null)
      echo "  }"
      echo "  chain fwd_out   { type filter hook postrouting priority 300; policy accept;"
      echo "    oif lo return"
      while IFS=$'\t' read -r _k proto port kind note src first state last; do
        [[ -z ${_k:-} || ${_k} == \#* ]] && continue
        [[ ${state:-live} == gone ]] && continue
        [[ $kind == fwd || $kind == redir ]] || continue
        _port_line_ok "$proto" "$port" || continue
        echo "    $proto sport $port counter comment \"tmF_${port}_${proto}\""
      done < <(cat "$PORTS" 2>/dev/null)
      echo "  }"
    fi
    echo "}"
  } > "$tmp"
  # 坏行统计单独扫一遍: 上面的计数发生在子 shell 内, 无法回传
  nbad=$(awk -F'\t' '
    function bad_port(p,   a,n) {
      if (p ~ /^[0-9]{1,5}$/) return (p+0 < 1 || p+0 > 65535)
      if (p ~ /^[0-9]{1,5}-[0-9]{1,5}$/) {
        n = split(p, a, "-")
        if (a[1]+0 < 1 || a[1]+0 > 65535) return 1
        if (a[2]+0 < 1 || a[2]+0 > 65535) return 1
        return (a[1]+0 >= a[2]+0)
      }
      return 1
    }
    $1!="" && $1 !~ /^#/ && $8!="gone" {
      if (($2!="tcp" && $2!="udp") || bad_port($3)) n++
    } END{print n+0}' "$PORTS" 2>/dev/null)
  (( nbad > 0 )) && logw "端口清单中有 $nbad 行格式非法, 已跳过 (不影响其余端口计数), 请检查 $PORTS"
  if nft -f "$tmp" 2>>"$LOG"; then
    snap_drop_ports
    mkdir -p "$STATE_DIR"; ports_fingerprint > "$STATE_DIR/ports.fp"
    nok=$(awk -F'\t' '$8!="gone"' "$PORTS" 2>/dev/null | grep -c .)
    logi "nft 计数表重建完成 table=inet $t 生效端口=$nok 跳过坏行=$nbad"
    rm -f "$tmp"; return 0
  else
    # 失败的规则文件落到固定位置, 便于排查; 同时避免 /tmp 里堆一堆随机名
    mkdir -p "$LIB_DIR" 2>/dev/null
    cp -f "$tmp" "$FAILED_NFT" 2>/dev/null && rm -f "$tmp"
    loge "nft 计数表建立失败, 规则文件保留于 $FAILED_NFT"
    return 1
  fi
}

nft_read() {
  local t=${NFT_TABLE:-$NFT_TABLE_DEFAULT}
  nft -a list table inet "$t" 2>/dev/null | awk '
    /chain / { ch=$2 }
    /counter packets/ {
      b=""; cm=""
      for(i=1;i<=NF;i++){ if($i=="bytes") b=$(i+1) }
      if (match($0,/comment "[^"]+"/)) { cm=substr($0,RSTART+9,RLENGTH-10) }
      if (cm!="" && b!="") print ch"\t"cm"\t"b
    }'
}

# 采集端口计数并累加 (供 do_collect 调用, 保证"先读后建")
collect_ports() {
  local ch cm b key dir dv n=0
  while IFS=$'\t' read -r ch cm b; do
    [[ -z ${cm:-} ]] && continue
    key=${cm#tm?_}; key="${key%_*}/${cm##*_}"
    case $ch in
      local_in|fwd_in)   dir=down ;;
      local_out|fwd_out) dir=up ;;
      *) continue ;;
    esac
    dv=$(snap_delta "p_${ch}_${cm}" "$b")
    (( dv == 0 )) && continue
    if [[ $dir == up ]]; then
      acc_add "$CYCLE" "$key" "$dv" 0; acc_add "$LIFE" "$key" "$dv" 0
    else
      acc_add "$CYCLE" "$key" 0 "$dv"; acc_add "$LIFE" "$key" 0 "$dv"
    fi
    n=$(( n + 1 ))
  done < <(nft_read)
  echo "$n"
}

# 安全重建: 任何会改变计数表结构的操作都必须走这里
# 1) 先把旧表当前计数落账, 避免重建清零导致丢数
# 2) 重建
# 3) 立刻读一次新表建立基线, 避免下一轮把新表值当增量
_nft_rebuild_safe_raw() {
  local t=${NFT_TABLE:-$NFT_TABLE_DEFAULT} n=0
  if nft_table_exists "$t"; then
    n=$(collect_ports)
    logd "重建前已落账 $n 项端口计数"
  fi
  nft_build || return 1
  local m; m=$(collect_ports)
  logd "重建后已建立新基线, 新表读取 $m 项"
  return 0
}
# 统一在采集锁内执行, 与定时器互斥
nft_rebuild_safe() { with_collect_lock _nft_rebuild_safe_raw; }

# ---------------------------------------------------------------- 端口注册
# 类型优先级: 同一端口既被本机监听又被 DNAT 命中时, 必须固定取一种, 否则
# 每轮发现都会来回翻转 kind, 导致端口指纹每轮变化 -> nft 表反复重建 -> 计数基线被清零
# 取值越大越优先。fwd/redir 优先于 local: 转发规则决定了包实际走哪条链
_kind_rank() {
  case ${1:-} in fwd) echo 3;; redir) echo 2;; local) echo 1;; *) echo 0;; esac
}
# last_seen 刷新降频。port_gc 依赖 last_seen 判定清理时机, 因此不能为了省
# I/O 就干脆不写 —— 那会让陈旧条目被提前删除。
# 折中: 无结构性变化时, 距上次刷新不足 LASTSEEN_MIN_GAP 秒则跳过写盘。
# 默认 3600 秒, 远小于 STALE_KEEP_DAYS (天级), 不影响清理判定。
LASTSEEN_MIN_GAP=${TRAFMGR_LASTSEEN_GAP:-3600}
port_add() {   # proto port kind note src
  local proto=$1 port=$2 kind=$3 note=${4:--} src=${5:-auto} k now
  k=$(pkey "$proto" "$port"); now=$(date '+%F %T')
  local ex; ex=$(tsv_get "$k" "$PORTS")
  if [[ -n $ex ]]; then
    local okind ostate ofirst osrc olast
    okind=$(printf '%s' "$ex" | cut -f4); ostate=$(printf '%s' "$ex" | cut -f8)
    ofirst=$(printf '%s' "$ex" | cut -f7); osrc=$(printf '%s' "$ex" | cut -f6)
    olast=$(printf '%s' "$ex" | cut -f9)
    [[ -z ${ostate:-} ]] && ostate=live
    # 本轮发现的类型优先级低于已记录的 -> 保持原类型, 只刷新 last_seen
    if [[ $okind != "$kind" ]] && (( $(_kind_rank "$kind") < $(_kind_rank "$okind") )); then
      logd "端口 $k 同时命中 $okind 与 $kind, 按优先级保持 $okind"
      kind=$okind
    fi
    # 来源只允许单向提升 auto -> manual, 不反向降级。
    # 否则手动添加一个已被自动发现的端口时 src 仍是 auto, 该端口照样会被自动
    # 标记 gone, 与界面"手动添加的端口不会被自动下线"的说明矛盾
    local nsrc=$osrc
    if [[ $src == manual && $osrc != manual ]]; then
      nsrc=manual
      audit_change "端口 $k 来源" "$osrc" "manual" "手动添加, 不再自动下线"
    fi
    # 仅刷新 last_seen: 无结构性变化
    if [[ $okind == "$kind" && $ostate == live && $nsrc == "$osrc" ]]; then
      # 降频写盘: 50 个端口每 5 分钟就是 50 次全文件重写, I/O 与 inode churn 偏高
      local ots nts
      ots=$(date -d "${olast:-1970-01-01}" +%s 2>/dev/null || echo 0)
      nts=$(date +%s)
      if (( nts - ots < LASTSEEN_MIN_GAP )); then
        return 1
      fi
      tsv_put "$PORTS" "$k" "$proto" "$port" "$kind" "$note" "$osrc" "$ofirst" live "$now"
      return 1
    fi
    tsv_put "$PORTS" "$k" "$proto" "$port" "$kind" "$note" "$nsrc" "$ofirst" live "$now"
    [[ $okind != "$kind" ]] && audit_change "端口 $k 类型" "$okind" "$kind"
    [[ $ostate == gone ]] && audit "端口 $k 重新上线"
    return 0
  fi
  tsv_put "$PORTS" "$k" "$proto" "$port" "$kind" "$note" "$src" "$now" live "$now"
  audit "新增端口 $k  类型=$kind  来源=$src  备注=$note"
  return 0
}
# 删除端口时连带清理该端口的配额与限速规则, 避免孤立残留
port_purge_refs() {
  local k=$1 n=0 lk proto port dirn rate st src
  if [[ -n $(tsv_get "$k" "$PQUOTA") ]]; then
    local ov; ov=$(tsv_get "$k" "$PQUOTA" | cut -f2)
    tsv_del "$PQUOTA" "$k"; audit "连带移除端口配额 $k  原值=$(fmt_bytes "${ov:-0}")"
  fi
  while IFS=$'\t' read -r lk proto port dirn rate st src; do
    [[ -z ${lk:-} ]] && continue
    [[ $lk == "${k}_"* ]] || continue
    tsv_del "$LIMITS" "$lk"; n=$(( n + 1 ))
    audit "连带移除限速规则 $lk"
  done < <(cat "$LIMITS" 2>/dev/null)
  (( n > 0 )) && nft_limit_build
  return 0
}
port_del() {
  local k=$1 ex; ex=$(tsv_get "$k" "$PORTS")
  [[ -z $ex ]] && return 1
  tsv_del "$PORTS" "$k"
  audit "删除端口 $k  原记录=[$(printf '%s' "$ex" | tr '\t' '|')]"
  port_purge_refs "$k"
}
port_mark_gone() {
  local k=$1 ex; ex=$(tsv_get "$k" "$PORTS")
  [[ -z $ex ]] && return 1
  local st; st=$(printf '%s' "$ex" | cut -f8)
  [[ ${st:-live} == gone ]] && return 1
  tsv_put "$PORTS" "$k" "$(printf '%s' "$ex" | cut -f2)" "$(printf '%s' "$ex" | cut -f3)" \
    "$(printf '%s' "$ex" | cut -f4)" "$(printf '%s' "$ex" | cut -f5)" "$(printf '%s' "$ex" | cut -f6)" \
    "$(printf '%s' "$ex" | cut -f7)" gone "$(printf '%s' "$ex" | cut -f9)"
  audit "端口 $k 已下线, 标记为 gone (统计保留)"
  return 0
}

# 自动清理: 长期下线且本周期无流量的条目
port_gc() {
  local keep=${STALE_KEEP_DAYS:-30} now cutoff n=0
  (( keep <= 0 )) && return 0
  now=$(date +%s); cutoff=$(( now - keep * 86400 ))
  local k proto port kind note src first state last ls u d
  while IFS=$'\t' read -r k proto port kind note src first state last; do
    [[ -z ${k:-} ]] && continue
    [[ ${state:-live} == gone ]] || continue
    ls=$(date -d "${last:-1970-01-01}" +%s 2>/dev/null || echo 0)
    (( ls > cutoff )) && continue
    read -r u d <<<"$(acc_get "$k" "$CYCLE")"
    (( u + d > 0 )) && continue
    tsv_del "$PORTS" "$k"
    audit "自动清理端口 $k  已下线超过 ${keep} 天且本周期无流量"
    port_purge_refs "$k"
    n=$(( n + 1 ))
  done < <(cat "$PORTS" 2>/dev/null)
  (( n > 0 )) && logi "端口清理完成, 移除 $n 个陈旧条目"
  return 0
}

# $1=force: 传 force 时忽略 AUTO_DISCOVER 开关 (供菜单"立即重新扫描"使用)
# 返回: 0=有变化  1=无变化  2=被开关跳过
do_discover() {
  local force=${1:-} changed=0 proto port svc kind tgt k
  if [[ $force != force && ${AUTO_DISCOVER:-1} != 1 ]]; then return 2; fi
  local seen; seen=$(mktemp)
  while IFS=$'\t' read -r proto port svc; do
    [[ -z ${proto:-} ]] && continue
    valid_port "$port" || continue
    printf '%s\n' "$(pkey "$proto" "$port")" >> "$seen"
    port_add "$proto" "$port" local "$svc" auto && changed=1
  done < <(discover_listen)
  if [[ ${COUNT_FORWARD:-1} == 1 ]]; then
    while IFS=$'\t' read -r proto port kind tgt; do
      [[ -z ${proto:-} ]] && continue
      valid_port "$port" || continue
      printf '%s\n' "$(pkey "$proto" "$port")" >> "$seen"
      port_add "$proto" "$port" "$kind" "$tgt" auto && changed=1
    done < <(discover_nat)
  fi
  # 本次未出现的自动发现端口 -> 标记 gone
  local ek esrc estate
  while IFS=$'\t' read -r k proto port kind note esrc first estate last; do
    [[ -z ${k:-} ]] && continue
    [[ ${esrc:-auto} == auto ]] || continue          # 手动添加的不自动下线
    [[ ${estate:-live} == live ]] || continue
    grep -qxF "$k" "$seen" 2>/dev/null && continue
    port_mark_gone "$k" && changed=1
  done < <(cat "$PORTS" 2>/dev/null)
  rm -f "$seen"
  port_gc
  return $(( changed == 1 ? 0 : 1 ))
}
# 采集内部调用: 只在开关打开时扫描
discover_if_enabled() { do_discover; local rc=$?; (( rc == 2 )) && return 1; return $rc; }

# ---------------------------------------------------------------- 采集
# 采集主体单独成函数, 由 with_collect_lock 统一持锁调用。
# 菜单侧的 nft_rebuild_safe 走同一把锁, 不会与定时器互相抢
_do_collect_body() {
  mkdir -p "$LIB_DIR" "$DAILY_DIR" "$STATE_DIR"
  if ! require_iface; then
    loge "采集中止: ${IFACE_ERR:-网卡不可用}"
    return 1
  fi
  [[ -f $STAMP ]] || { date '+%s' > "$STAMP"; audit "首次采集, 记录安装时间戳 $(date '+%F %T')"; }

  # 周期切换检查
  local now sc se cs
  now=$(date +%s); read -r sc se <<<"$(cycle_range "${RESET_DAY:-1}" "$now")"
  cs=$(cat "$CYCLE_START" 2>/dev/null || echo 0)
  [[ $cs =~ ^[0-9]+$ ]] || cs=0
  if (( cs != sc )); then
    # 周期切换是"归档 -> 清零 -> 写周期起点"三步串联, 每一步都必须校验返回值。
    # 磁盘满 / 只读挂载时, 忽略返回值会导致:
    #   归档失败却记"已归档"  -> 上一周期数据静默丢失
    #   清零失败却写了新起点  -> 旧数据混入新周期, 配额判定虚高
    #   起点写入失败          -> 下一轮再次触发切换, 反复归档与清零
    # 任何一步失败都中止本次切换, 保持旧状态, 下一轮重试, 并如实告警。
    local _sw_ok=1
    if (( cs != 0 )); then
      local ar; ar="$DAILY_DIR/$(date -d "@$cs" +%Y-%m-%d)_cycle.tsv"
      local cu cd; read -r cu cd <<<"$(acc_get nic "$CYCLE")"
      if cp -f "$CYCLE" "$ar" 2>/dev/null; then
        audit "计费周期结束 $(date -d "@$cs" '+%F') 上传=$(fmt_bytes "$cu") 下载=$(fmt_bytes "$cd") 已归档 $ar"
      else
        _sw_ok=0
        loge "周期归档失败: 无法写入 $ar (磁盘满或只读?), 本次周期切换已中止, 下轮重试"
      fi
    fi
    if (( _sw_ok == 1 )); then
      if ! tsv_truncate "$CYCLE"; then
        _sw_ok=0
        loge "周期清零失败: 无法截断 $CYCLE, 本次周期切换已中止, 下轮重试"
      fi
    fi
    if (( _sw_ok == 1 )); then
      if printf '%s\n' "$sc" | atomic_write "$CYCLE_START"; then
        audit "计费周期开始 $(date -d "@$sc" '+%F')  下次重置 $(date -d "@$se" '+%F')"
        [[ ${RESET_CLEAR_LIMITS:-1} == 1 ]] && enforce_clear "周期重置自动解除"
        # 归档目录同步清理, 避免只写不读无限增长
        daily_gc
      else
        # 已清零但起点没写成: 明确告警, 下一轮会再次进入切换分支重试写入
        loge "周期起点写入失败: $CYCLE_START 不可写。本期计数已清零但起点未更新, 下轮将重试"
      fi
    fi
  fi

  # 网卡总量 (权威)
  # 快照键绑定网卡名: 换网卡后是全新计数器, 不能与旧网卡共用基线, 否则增量会算错
  local rx tx drx dtx
  rx=$(if_bytes "$RIFACE" rx); tx=$(if_bytes "$RIFACE" tx)
  drx=$(snap_delta "nic_${RIFACE}_rx" "$rx"); dtx=$(snap_delta "nic_${RIFACE}_tx" "$tx")
  acc_add "$CYCLE" nic "$dtx" "$drx"
  acc_add "$LIFE"  nic "$dtx" "$drx"
  acc_add "$DAILY_DIR/$(date +%Y-%m).tsv" "$(date +%F)" "$dtx" "$drx"

  # === 关键顺序: 先读旧表计数, 再按需重建 ===
  local t=${NFT_TABLE:-$NFT_TABLE_DEFAULT} nread=0
  if nft_table_exists "$t"; then
    nread=$(collect_ports)
    logd "端口计数已采集 $nread 项"
  else
    logw "nft 计数表不存在, 将重建"
  fi

  # 端口发现: 变化只影响下一轮的表结构, 不丢当前计数
  # 重建与否完全由下面的指纹比对驱动, 此处不需要记录"是否有变化"
  discover_if_enabled
  local newfp oldfp nbase=0
  newfp=$(ports_fingerprint); oldfp=$(cat "$STATE_DIR/ports.fp" 2>/dev/null || echo "")
  local rebuilt=0
  if ! nft_table_exists "$t"; then
    nft_build && rebuilt=1
  elif [[ $newfp != "$oldfp" ]]; then
    logi "端口清单变化, 重建计数表 (本轮计数已先行采集)"
    nft_build && rebuilt=1
  fi
  # 重建后立即读一次新表建立基线, 避免白白丢掉一个采集周期
  if (( rebuilt == 1 )); then
    nbase=$(collect_ports)
    logd "新表基线已建立"
  fi

  date +%s | atomic_write "$LASTRUN"
  # 落账数与基线数分开记录: 合成一个数字会让首次建表时的 0 被误读为"没采到数据"
  logi "采集完成 iface=$RIFACE 上传+$(fmt_bytes "$dtx") 下载+$(fmt_bytes "$drx") 重建前落账=$nread 重建后基线=$nbase"
  enforce_check
  return 0
}
do_collect() {
  LOG_TAG=collect
  cfg_load
  mkdir -p "$LIB_DIR" 2>/dev/null
  # 重入保护: 采集慢于间隔时避免多进程叠加。
  # 定时器场景用 -n 立即放弃, 交互场景由 with_collect_lock 等待
  if command -v flock >/dev/null 2>&1; then
    local rc
    ( flock -n 8 || { logw "上一轮采集尚未结束, 本轮跳过"; exit 3; }
      _do_collect_body ) 8>"$COLLECT_LOCK_FILE"
    rc=$?
    (( rc == 3 )) && return 0
    return $rc
  fi
  _do_collect_body
}

# 归档清理: 月度 tsv 与 *_cycle.tsv 由菜单 h 展示, 此处负责按期回收
daily_gc() {
  local keep=${STALE_KEEP_DAYS:-30} n
  (( keep <= 0 )) && return 0
  [[ -d $DAILY_DIR ]] || return 0
  # 归档保留期取 STALE_KEEP_DAYS 的 12 倍且不少于 365 天, 历史用量值得多留
  local days=$(( keep * 12 )); (( days < 365 )) && days=365
  n=$(find "$DAILY_DIR" -maxdepth 1 -type f -name '*.tsv' -mtime "+$days" -print 2>/dev/null | wc -l)
  [[ $n =~ ^[0-9]+$ ]] || n=0
  if (( n > 0 )); then
    find "$DAILY_DIR" -maxdepth 1 -type f -name '*.tsv' -mtime "+$days" -delete 2>/dev/null
    audit "清理历史归档 $n 个 (保留 ${days} 天)"
  fi
  return 0
}

# ---------------------------------------------------------------- 用量与配额
usage_cycle() { acc_get nic "$CYCLE"; }
usage_life()  { acc_get nic "$LIFE"; }
basis_value() {
  local u=$1 d=$2
  case ${QUOTA_BASIS:-total} in
    up)   echo "$u" ;;
    down) echo "$d" ;;
    max)  (( u > d )) && echo "$u" || echo "$d" ;;
    *)    echo $(( u + d )) ;;
  esac
}
basis_name() {
  case ${QUOTA_BASIS:-total} in
    up) echo "仅上传";; down) echo "仅下载";; max) echo "取上下较大";; *) echo "合计";;
  esac
}
# 端口配额独立口径: 与整机配额分开, 避免改整机口径时静默改变端口判定
pbasis_value() {
  local u=$1 d=$2
  case ${PQUOTA_BASIS:-total} in
    up)   echo "$u" ;;
    down) echo "$d" ;;
    max)  (( u > d )) && echo "$u" || echo "$d" ;;
    *)    echo $(( u + d )) ;;
  esac
}
pbasis_name() {
  case ${PQUOTA_BASIS:-total} in
    up) echo "仅上传";; down) echo "仅下载";; max) echo "取上下较大";; *) echo "上传+下载合计";;
  esac
}
# 整机限速触发阈值 (先除后乘防溢出, 单处实现避免两处写法漂移)
host_threshold() {
  local q=${QUOTA:-0} p=${ENFORCE_HOST_AT:-100}
  (( q <= 0 )) && { echo 0; return; }
  (( p <= 0 )) && p=1
  if (( q > 9223372036854775807 / p )); then echo $(( q / 100 * p ))
  else echo $(( q * p / 100 )); fi
}

# ---------------------------------------------------------------- 限速 (nft limit)
LIMIT_TABLE_SUFFIX="_lim"
# 查询端口在监控清单中的类型: local / fwd / redir / 未知(默认按 local+fwd 双挂)
port_kind_of() {
  local k=$1 kd
  kd=$(tsv_get "$k" "$PORTS" | cut -f4)
  case ${kd:-} in local|fwd|redir) printf '%s' "$kd" ;; *) printf 'unknown' ;; esac
}
# 挂载位置说明, 供菜单预览使用。文案必须与实际挂链行为一致, 否则会误导用户
kind_hook_desc() {
  case ${1:-} in
    fwd)     echo "forward 链" ;;
    redir)   echo "input/output 链 (ct original 还原公网端口)" ;;
    local)   echo "input/output 链" ;;
    *)       echo "input/output 与 forward 全部挂载 (类型未知, 保守处理)" ;;
  esac
}

nft_limit_build() {
  local t="${NFT_TABLE:-$NFT_TABLE_DEFAULT}$LIMIT_TABLE_SUFFIX"
  nft_ok || return 1
  nft_guard_table "$t" "建立限速表" || return 1
  local n; n=$(nlines "$LIMITS")
  if (( n == 0 )); then
    nft_delete_own_table "$t" && logi "限速规则为空, 已移除限速表"
    return 0
  fi
  local tmp; tmp=$(mktemp) || return 1
  {
    echo "table inet $t"
    echo "delete table inet $t"
    echo "table inet $t {"
    # 空标记链, 兼容 nftables 0.9.x
    echo "  chain $NFT_MARK_CHAIN { }"

    # ---- 本机服务限速: 走 input / output ----
    echo "  chain lim_out { type filter hook output priority 100; policy accept;"
    echo "    oif lo return"
    local sp
    for sp in ${RSSH_LIST:-$RSSH}; do
      echo "    tcp sport $sp accept"
      echo "    tcp dport $sp accept"
    done
    while IFS=$'\t' read -r key proto port dirn rate st src; do
      [[ -z ${key:-} || ${st:-} != on ]] && continue
      [[ $dirn == out || $dirn == both ]] || continue
      # 限速表同样做行级校验: 单条坏规则不得让整表 nft -f 失败
      _port_line_ok "$proto" "$port" || continue
      local kd; kd=$(port_kind_of "$(pkey "$proto" "$port")")
      # redir(REDIRECT) 是 DNAT 到本机, 包走 input/output 而非 forward, 必须在这里挂
      [[ $kd == local || $kd == redir || $kd == unknown ]] || continue
      local kbs; kbs=$(parse_rate_kbs "$rate"); [[ $kbs == ERR ]] && continue
      if [[ $kd == redir ]]; then
        # REDIRECT 改写了目的端口, 本机看到的是内部端口, 用 ct original 还原公网端口
        echo "    meta l4proto $proto ct original proto-dst $port ct direction reply limit rate over $kbs kbytes/second burst 32 kbytes drop"
      else
        echo "    $proto sport $port limit rate over $kbs kbytes/second burst 32 kbytes drop"
      fi
    done < <(cat "$LIMITS" 2>/dev/null)
    echo "  }"
    echo "  chain lim_in { type filter hook input priority 100; policy accept;"
    echo "    iif lo return"
    for sp in ${RSSH_LIST:-$RSSH}; do
      echo "    tcp dport $sp accept"
      echo "    tcp sport $sp accept"
    done
    while IFS=$'\t' read -r key proto port dirn rate st src; do
      [[ -z ${key:-} || ${st:-} != on ]] && continue
      [[ $dirn == in || $dirn == both ]] || continue
      _port_line_ok "$proto" "$port" || continue
      local kd; kd=$(port_kind_of "$(pkey "$proto" "$port")")
      [[ $kd == local || $kd == redir || $kd == unknown ]] || continue
      local kbs; kbs=$(parse_rate_kbs "$rate"); [[ $kbs == ERR ]] && continue
      if [[ $kd == redir ]]; then
        echo "    meta l4proto $proto ct original proto-dst $port ct direction original limit rate over $kbs kbytes/second burst 32 kbytes drop"
      else
        echo "    $proto dport $port limit rate over $kbs kbytes/second burst 32 kbytes drop"
      fi
    done < <(cat "$LIMITS" 2>/dev/null)
    echo "  }"

    # ---- 转发/跳跃端口限速: 必须走 forward, 转发包不经过 input/output ----
    # 入方向 = 客户端 -> 本机(公网端口), 用 ct original proto-dst 还原 NAT 前端口
    # 出方向 = 本机 -> 客户端(回程), 用 ct original proto-dst 同样匹配同一条连接
    echo "  chain lim_fwd { type filter hook forward priority 100; policy accept;"
    echo "    iif lo return"
    echo "    oif lo return"
    for sp in ${RSSH_LIST:-$RSSH}; do
      echo "    tcp dport $sp accept"
      echo "    tcp sport $sp accept"
    done
    while IFS=$'\t' read -r key proto port dirn rate st src; do
      [[ -z ${key:-} || ${st:-} != on ]] && continue
      _port_line_ok "$proto" "$port" || continue
      local kd; kd=$(port_kind_of "$(pkey "$proto" "$port")")
      # redir 走 input/output, 不在 forward 链处理
      [[ $kd == fwd || $kd == unknown ]] || continue
      local kbs; kbs=$(parse_rate_kbs "$rate"); [[ $kbs == ERR ]] && continue
      # 入方向 = 客户端->服务端, 必须限定 ct direction original
      # 否则 ct original proto-dst 对去程与回程都成立, 选"入站"会误限双向
      if [[ $dirn == in || $dirn == both ]]; then
        echo "    meta l4proto $proto ct original proto-dst $port ct direction original limit rate over $kbs kbytes/second burst 32 kbytes drop"
      fi
      # 出方向 = 服务端->客户端的回程包
      if [[ $dirn == out || $dirn == both ]]; then
        echo "    meta l4proto $proto ct original proto-dst $port ct direction reply limit rate over $kbs kbytes/second burst 32 kbytes drop"
      fi
    done < <(cat "$LIMITS" 2>/dev/null)
    echo "  }"
    echo "}"
  } > "$tmp"
  if nft -f "$tmp" 2>>"$LOG"; then
    audit "限速表已应用 生效规则=$(awk -F'\t' '$6=="on"' "$LIMITS" 2>/dev/null | grep -c .) SSH豁免=${RSSH_LIST:-$RSSH}"
    rm -f "$tmp"; return 0
  fi
  # 整表失败后降级为逐条下发, 跳过内核/版本不接受的规则, 保住其余限速。
  # 典型诱因是 ct original proto-dst 的端口段写法在旧版 nft 上不被接受。
  logw "限速表整体应用失败, 尝试逐条下发以定位不被接受的规则"
  if nft_limit_build_fallback "$t" "$tmp"; then
    rm -f "$tmp"; return 0
  fi
  mkdir -p "$LIB_DIR" 2>/dev/null
  cp -f "$tmp" "$FAILED_NFT" 2>/dev/null && rm -f "$tmp"
  loge "限速表应用失败, 规则保留于 $FAILED_NFT"
  return 1
}

# 降级下发: 先建骨架 (标记链 + 三条空链 + SSH 豁免), 再逐条 add rule。
# 任何一条不被接受就跳过并记录, 不让整表一起失效。
nft_limit_build_fallback() {
  local t=$1 src=$2 skel; skel=$(mktemp) || return 1
  local sp
  {
    echo "table inet $t"
    echo "delete table inet $t"
    echo "table inet $t {"
    echo "  chain $NFT_MARK_CHAIN { }"
    echo "  chain lim_out { type filter hook output priority 100; policy accept;"
    echo "    oif lo return"
    for sp in ${RSSH_LIST:-$RSSH}; do echo "    tcp sport $sp accept"; echo "    tcp dport $sp accept"; done
    echo "  }"
    echo "  chain lim_in { type filter hook input priority 100; policy accept;"
    echo "    iif lo return"
    for sp in ${RSSH_LIST:-$RSSH}; do echo "    tcp dport $sp accept"; echo "    tcp sport $sp accept"; done
    echo "  }"
    echo "  chain lim_fwd { type filter hook forward priority 100; policy accept;"
    echo "    iif lo return"
    echo "    oif lo return"
    for sp in ${RSSH_LIST:-$RSSH}; do echo "    tcp dport $sp accept"; echo "    tcp sport $sp accept"; done
    echo "  }"
    echo "}"
  } > "$skel"
  if ! nft -f "$skel" 2>>"$LOG"; then
    loge "限速表骨架建立失败, 降级下发中止"
    rm -f "$skel"; return 1
  fi
  rm -f "$skel"
  # 从完整规则文件里抽出 limit 规则, 按所属链逐条 add
  local ch="" line rule nok=0 nskip=0
  while IFS= read -r line; do
    case $line in
      *"chain lim_out"*) ch=lim_out; continue ;;
      *"chain lim_in"*)  ch=lim_in;  continue ;;
      *"chain lim_fwd"*) ch=lim_fwd; continue ;;
    esac
    [[ $line == *"limit rate over"* ]] || continue
    [[ -n $ch ]] || continue
    rule=${line#"${line%%[![:space:]]*}"}
    if nft add rule inet "$t" "$ch" $rule 2>>"$LOG"; then
      nok=$(( nok + 1 ))
    else
      nskip=$(( nskip + 1 ))
      logw "限速规则被内核拒绝, 已跳过: [$ch] $rule"
    fi
  done < "$src"
  audit "限速表降级下发完成 成功=$nok 跳过=$nskip (跳过的规则多为当前 nft 版本不支持的表达式)"
  # 一条都没成功 = 限速完全没生效, 此时绝不能返回 0。
  # 否则界面显示"已添加并生效", 而内核里只有一张空骨架表, 用户以为限速在跑、
  # 实际完全不限 —— 这是最危险的一类"假成功"。
  if (( nok == 0 )); then
    if (( nskip > 0 )); then
      loge "降级下发失败: $nskip 条限速规则全部被内核拒绝, 当前无任何限速生效"
      printf '  %s限速未生效: %s 条规则全部不被当前 nftables 接受%s\n' "${C_E:-}" "$nskip" "${C_R:-}" >&2
      printf '  %s可执行  trafmgr --selftest  查看本机支持哪些表达式%s\n' "${C_E:-}" "${C_R:-}" >&2
    else
      logw "降级下发未产生任何规则 (无 on 状态的限速项)"
    fi
    # 只留骨架表会让 menu_limits / menu_diag 显示"限速表已建立"造成误解, 一并清掉
    nft_delete_own_table "$t" 2>/dev/null
    return 1
  fi
  if (( nskip > 0 )); then
    printf '  %s提示: %s 条限速规则不被当前 nftables 版本接受, 已跳过 (另有 %s 条已生效), 详见 %s%s\n' \
      "${C_Y:-}" "$nskip" "$nok" "$LOG" "${C_R:-}" >&2
  fi
  return 0
}

limit_add() {   # proto port dir rate [src]
  local proto=$1 port=$2 dirn=$3 rate=$4 src=${5:-manual} k
  k="$(pkey "$proto" "$port")_$dirn"
  # 按数值区间判断: 字符串比较会让端口段 20-30 匹配不到 22, 从而放行对 SSH 的限速
  if port_overlaps_ssh "$port"; then
    echo "  拒绝: $port 与 SSH 豁免列表 (${RSSH_LIST:-$RSSH}) 有交集, 不可限速"
    audit "拒绝对与 SSH 豁免列表交集的端口 $port 限速"
    return 1
  fi
  tsv_put "$LIMITS" "$k" "$proto" "$port" "$dirn" "$rate" on "$src" || return 1
  audit "新增限速 $k  速率=$rate  方向=$dirn  来源=$src"
  nft_limit_build
}
limit_del() {
  local k=$1 ex; ex=$(tsv_get "$k" "$LIMITS")
  [[ -z $ex ]] && return 1
  tsv_del "$LIMITS" "$k"; audit "删除限速 $k  原记录=[$(printf '%s' "$ex" | tr '\t' '|')]"
  nft_limit_build
}
limit_toggle() {
  local k=$1 ex st nst
  ex=$(tsv_get "$k" "$LIMITS"); [[ -z $ex ]] && return 1
  st=$(printf '%s' "$ex" | cut -f6); [[ $st == on ]] && nst=off || nst=on
  tsv_put "$LIMITS" "$k" "$(printf '%s' "$ex" | cut -f2)" "$(printf '%s' "$ex" | cut -f3)" \
          "$(printf '%s' "$ex" | cut -f4)" "$(printf '%s' "$ex" | cut -f5)" "$nst" "$(printf '%s' "$ex" | cut -f7)"
  audit_change "限速 $k 状态" "$st" "$nst"
  nft_limit_build
}

# ---------------------------------------------------------------- 端口配额
pquota_set() {
  local k=$1 bytes=$2 ov
  ov=$(tsv_get "$k" "$PQUOTA" | cut -f2)
  if (( bytes == 0 )); then
    tsv_del "$PQUOTA" "$k"; audit "移除端口配额 $k  原值=${ov:-无}"
  else
    tsv_put "$PQUOTA" "$k" "$bytes" || return 1
    audit_change "端口配额 $k" "$( [[ -n ${ov:-} ]] && fmt_bytes "$ov" || echo 未设置 )" "$(fmt_bytes "$bytes")"
  fi
  return 0
}
pquota_get() {
  local v; v=$(tsv_get "$1" "$PQUOTA" | cut -f2)
  [[ $v =~ ^[0-9]+$ ]] || v=0
  echo "$v"
}

# ---------------------------------------------------------------- 超额执行
# 整机限速状态的唯一真相是"_enf 表是否存在", ENF_STATE 只是展示用的附加信息。
# 不要改回以状态文件作为判据, 那会导致:
#   人工删掉 _enf 表后状态文件仍在 -> 永远不再施加限速
#   删表失败却删了状态文件         -> 界面显示未限速, 内核仍在丢包
ENF_STATE="$STATE_DIR/enforce"
ENF_TAG="__ENF__"
enf_table() { printf '%s_enf' "${NFT_TABLE:-$NFT_TABLE_DEFAULT}"; }
# 真实状态: 整机限速是否正在生效
enforce_host_active() { nft_table_exists "$(enf_table)"; }

enforce_clear() {
  local why=${1:-手动解除} n=0 host_rc=0
  local t; t=$(enf_table)
  if nft_table_exists "$t"; then
    if nft_delete_own_table "$t"; then
      audit "解除整机超额限速  原因=$why"
      rm -f "$ENF_STATE" 2>/dev/null
    else
      # 表没删掉就绝不能删状态文件, 否则界面与内核彻底脱节
      host_rc=1
      loge "整机超额限速表 inet $t 删除失败, 限速仍在生效; 已保留状态文件以免显示失真"
      printf '  %s警告: 整机限速表 inet %s 未能删除, 限速仍在生效, 请手动检查%s\n' \
        "${C_E:-}" "$t" "${C_R:-}" >&2
    fi
  else
    # 表本就不存在: 清掉可能遗留的状态文件, 使两者一致
    rm -f "$ENF_STATE" 2>/dev/null
  fi
  # 清除由超额自动下发的端口限速
  local k proto port dirn rate st src
  while IFS=$'\t' read -r k proto port dirn rate st src; do
    [[ -z ${k:-} ]] && continue
    [[ ${src:-manual} == "$ENF_TAG" ]] || continue
    tsv_del "$LIMITS" "$k"; n=$(( n + 1 ))
    audit "解除端口超额限速 $k  原因=$why"
  done < <(cat "$LIMITS" 2>/dev/null)
  (( n > 0 )) && nft_limit_build
  return $host_rc
}
enforce_apply_host() {
  local rate=$1 t kbs; t=$(enf_table)
  nft_guard_table "$t" "整机超额限速" || return 1
  kbs=$(parse_rate_kbs "$rate"); [[ $kbs == ERR ]] && { loge "整机限速速率非法: $rate"; return 1; }
  local tmp exo exi sp; tmp=$(mktemp) || return 1; exo=""; exi=""
  for sp in ${RSSH_LIST:-$RSSH}; do
    exo+="    tcp sport $sp accept"$'\n'"    tcp dport $sp accept"$'\n'
    exi+="    tcp dport $sp accept"$'\n'"    tcp sport $sp accept"$'\n'
  done
  # 空标记链, 兼容 nftables 0.9.x
  cat > "$tmp" <<EOF
table inet $t
delete table inet $t
table inet $t {
  chain $NFT_MARK_CHAIN { }
  chain enf_out { type filter hook output priority 110; policy accept;
    oif lo return
${exo}    limit rate over $kbs kbytes/second burst 64 kbytes drop
  }
  chain enf_in { type filter hook input priority 110; policy accept;
    iif lo return
${exi}    limit rate over $kbs kbytes/second burst 64 kbytes drop
  }
  chain enf_fwd { type filter hook forward priority 110; policy accept;
    iif lo return
    oif lo return
${exi}    limit rate over $kbs kbytes/second burst 64 kbytes drop
  }
}
EOF
  if nft -f "$tmp" 2>>"$LOG"; then
    mkdir -p "$STATE_DIR"; echo "整机 $rate  触发于 $(date '+%F %T')" > "$ENF_STATE"
    audit "触发整机超额限速  速率=$rate  SSH豁免=${RSSH_LIST:-$RSSH}"
    rm -f "$tmp"; return 0
  else
    mkdir -p "$LIB_DIR" 2>/dev/null
    cp -f "$tmp" "$FAILED_NFT" 2>/dev/null && rm -f "$tmp"
    loge "整机超额限速应用失败, 规则保留于 $FAILED_NFT"; return 1
  fi
}

# 整机限速回收: 配额调高 / 配额清零 / 阈值调高 / 开关关闭 后自动解除。
# 缺了这一步, 用户提高配额后仍会被限速, 只能手动进菜单解除, 极易被当成故障。
enforce_reap_host() {
  enforce_host_active || return 0
  local reason="" u d used at
  if [[ ${ENFORCE_HOST:-0} != 1 ]]; then
    reason="整机限制开关已关闭"
  elif (( ${QUOTA:-0} <= 0 )); then
    reason="配额已取消"
  else
    read -r u d <<<"$(usage_cycle)"
    used=$(basis_value "$u" "$d")
    at=$(host_threshold)
    (( used < at )) && reason="用量 $(fmt_bytes "$used") 已低于阈值 $(fmt_bytes "$at")"
  fi
  [[ -z $reason ]] && return 0
  local t; t=$(enf_table)
  if nft_delete_own_table "$t"; then
    rm -f "$ENF_STATE" 2>/dev/null
    audit "自动解除整机超额限速  原因=$reason"
    return 0
  fi
  loge "自动解除整机限速失败: inet $t 未能删除"
  return 1
}

# 回收不再该存在的端口自动限速:
#  - 配额被删除 / 调高到当前用量之上
#  - 端口限制总开关被关闭
enforce_reap_ports() {
  local n=0 k proto port dirn rate st src pq u d used
  while IFS=$'\t' read -r k proto port dirn rate st src; do
    [[ -z ${k:-} ]] && continue
    [[ ${src:-manual} == "$ENF_TAG" ]] || continue      # 只回收自动下发的
    local pk="${k%_*}"                                   # 去掉 _both 还原端口键
    local drop=0
    if [[ ${ENFORCE_PORT:-0} != 1 ]]; then
      drop=1
    else
      pq=$(pquota_get "$pk")
      if (( pq == 0 )); then drop=1
      else
        read -r u d <<<"$(acc_get "$pk" "$CYCLE")"
        used=$(pbasis_value "$u" "$d")
        (( used < pq )) && drop=1
      fi
    fi
    if (( drop == 1 )); then
      tsv_del "$LIMITS" "$k"; n=$(( n + 1 ))
      audit "解除端口自动限速 $k  原因=配额已移除/调高或端口限制已关闭"
    fi
  done < <(cat "$LIMITS" 2>/dev/null)
  (( n > 0 )) && nft_limit_build
  return 0
}

# 端口级超额检查: 逐端口比对配额, 超出即自动下发限速
enforce_check_ports() {
  enforce_reap_ports
  [[ ${ENFORCE_PORT:-0} == 1 ]] || return 0
  local n=0 k q u d used proto port lk
  while IFS=$'\t' read -r k q; do
    [[ -z ${k:-} ]] && continue
    [[ $q =~ ^[0-9]+$ ]] || continue
    (( q == 0 )) && continue
    read -r u d <<<"$(acc_get "$k" "$CYCLE")"
    used=$(pbasis_value "$u" "$d")
    (( used < q )) && continue
    port=${k%%/*}; proto=${k##*/}
    # 端口段同样要按区间判断是否与 SSH 豁免有交集
    port_overlaps_ssh "$port" && continue
    # 该端口任意方向已有生效规则就跳过: 与手动 _in/_out 叠加会形成两个独立令牌桶
    if awk -F'\t' -v pk="$k" '$1 ~ "^"pk"_" && $6=="on" {found=1} END{exit !found}' "$LIMITS" 2>/dev/null; then
      logd "端口 $k 已存在生效中的限速规则, 跳过自动下发 (避免重复令牌桶)"
      continue
    fi
    lk="${k}_both"
    tsv_put "$LIMITS" "$lk" "$proto" "$port" both "${ENFORCE_PORT_RATE:-1M}" on "$ENF_TAG" || continue
    audit "端口 $k 用量 $(fmt_bytes "$used") (口径 $(pbasis_name)) 达配额 $(fmt_bytes "$q"), 自动限速至 ${ENFORCE_PORT_RATE:-1M}"
    n=$(( n + 1 ))
  done < <(cat "$PQUOTA" 2>/dev/null)
  (( n > 0 )) && nft_limit_build
  return 0
}

enforce_check() {
  # 保存调用方的日志标签, 返回前恢复, 避免后续日志被误标为 enforce
  local _oldtag=${LOG_TAG:-main}
  LOG_TAG=enforce
  enforce_check_ports
  # 先回收再施加: 顺序反了会导致配额调高后当轮仍不解除
  enforce_reap_host
  if [[ ${ENFORCE_HOST:-0} != 1 ]] || (( ${QUOTA:-0} <= 0 )); then
    LOG_TAG=$_oldtag; return 0
  fi
  local u d used at
  read -r u d <<<"$(usage_cycle)"
  used=$(basis_value "$u" "$d")
  at=$(host_threshold)
  # 判据是"表是否真实存在", 不依赖状态文件
  if (( used >= at )) && ! enforce_host_active; then
    audit "整机用量 $(fmt_bytes "$used") 达阈值 $(fmt_bytes "$at") (配额 $(fmt_bytes "$QUOTA") 的 ${ENFORCE_HOST_AT}%)"
    enforce_apply_host "${ENFORCE_HOST_RATE:-1M}"
  fi
  LOG_TAG=$_oldtag
  return 0
}

# ---------------------------------------------------------------- 显示
C_R=$'\033[0m'; C_B=$'\033[1m'; C_D=$'\033[2m'
C_G=$'\033[32m'; C_Y=$'\033[33m'; C_E=$'\033[31m'
[[ -t 1 ]] || { C_R=; C_B=; C_D=; C_G=; C_Y=; C_E=; }
# 显示宽度: 按 UTF-8 首字节统计, 三字节字符 (CJK) 记 2 列
dwidth() {
  local s=$1 b n2 n3 n4
  b=$(LC_ALL=C printf '%s' "$s" | wc -c)
  n2=$(LC_ALL=C grep -o $'[\xc0-\xdf]' <<< "$s" 2>/dev/null | wc -l)
  n3=$(LC_ALL=C grep -o $'[\xe0-\xef]' <<< "$s" 2>/dev/null | wc -l)
  n4=$(LC_ALL=C grep -o $'[\xf0-\xf7]' <<< "$s" 2>/dev/null | wc -l)
  echo $(( b - n2 - n3 - n4 * 2 ))
}
padr() { local s=$1 w=$2 n; n=$(( w - $(dwidth "$s") )); (( n < 0 )) && n=0; printf '%s%*s' "$s" "$n" ""; }
padl() { local s=$1 w=$2 n; n=$(( w - $(dwidth "$s") )); (( n < 0 )) && n=0; printf '%*s%s' "$n" "" "$s"; }
hr(){ printf '  %s\n' "------------------------------------------------------------------"; }
title(){ printf '\n  %s%s%s\n' "$C_B" "$1" "$C_R"; }

show_header() {
  local host lastrun ago st inst up
  host=$(hostname 2>/dev/null || cat /etc/hostname 2>/dev/null || echo localhost)
  inst=$(cat "$STAMP" 2>/dev/null || echo 0); [[ $inst =~ ^[0-9]+$ ]] || inst=0
  up=$(( $(date +%s) - inst )); (( inst == 0 )) && up=0
  lastrun=$(cat "$LASTRUN" 2>/dev/null || echo 0); [[ $lastrun =~ ^[0-9]+$ ]] || lastrun=0
  if (( lastrun == 0 )); then st="${C_Y}尚未采集${C_R}"; ago="-"
  else
    ago=$(( $(date +%s) - lastrun ))
    if (( ago > ${COLLECT_INTERVAL:-5} * 60 * 3 )); then st="${C_E}采集异常${C_R}"; else st="${C_G}采集正常${C_R}"; fi
    ago="$(( ago / 60 )) 分钟前"
  fi
  local ifshow=${RIFACE:-}
  [[ -z $ifshow ]] && ifshow="${C_E}网卡未确定${C_R}"
  printf '\n  %strafmgr%s  v%s   %s   %s  %s\n' "$C_B" "$C_R" "$VERSION" "$host" "$ifshow" "${RIP:-无IP}"
  printf '  脚本已运行  %s %s  %s\n' "$(padr "$(fmt_dur "$up")" 28)" "$st" "$ago"
}

show_usage_block() {
  local label=$1 u=$2 d=$3
  local tot=$(( u + d ))
  printf '  %s %s %s %s\n' "$(padr "$label" 12)" "$(padl "$(fmt_bytes "$u")" 14)" "$(padl "$(fmt_bytes "$d")" 14)" "$(padl "$(fmt_bytes "$tot")" 14)"
}

# 预计用尽日期。avg 极小时 remain/avg 会溢出 date 的可表示范围, 屏幕上会冒出
# 一行 date 报错 —— 新装首日用量很小时就会触发。先 cap 到 3650 天再计算。
eta_text() {
  local remain=$1 avg=$2 now=$3 days
  (( avg <= 0 || remain <= 0 )) && { printf ''; return; }
  days=$(( remain / avg ))
  if (( days > 3650 )); then printf '     预计 > 10 年后用尽'; return; fi
  printf '     预计 %s 用尽' "$(date -d "@$(( now + days * 86400 ))" +%m-%d 2>/dev/null || echo 未知)"
}

show_dashboard() {
  local u d now sc se days total_days used q avg
  read -r u d <<<"$(usage_cycle)"
  now=$(date +%s); read -r sc se <<<"$(cycle_range "${RESET_DAY:-1}" "$now")"
  days=$(( (now - sc) / 86400 + 1 )); (( days < 1 )) && days=1
  total_days=$(( (se - sc) / 86400 ))
  used=$(basis_value "$u" "$d"); q=${QUOTA:-0}
  avg=$(( used / days ))

  show_header
  if ! require_iface; then
    printf '  %s警告: %s  统计已暂停, 请在菜单 1 -> 2 重新探测%s\n' "$C_E" "${IFACE_ERR:-网卡不可用}" "$C_R"
  fi
  hr
  printf '  本期用量    每月 %s 号重置    %s ~ %s    第 %d/%d 天\n' \
    "${RESET_DAY:-1}" "$(date -d "@$sc" +%m-%d)" "$(date -d "@$((se-86400))" +%m-%d)" "$days" "$total_days"
  hr
  printf '  %s %s %s %s\n' "$(padr "" 12)" "$(padl 上传 14)" "$(padl 下载 14)" "$(padl 合计 14)"
  show_usage_block "流量" "$u" "$d"
  if (( q > 0 )); then
    printf '  %s %s   口径:%s\n' "$(padr 配额 12)" "$(padl "$(fmt_bytes "$q")" 44)" "$(basis_name)"
    printf '  [%s]  %s\n' "$(bar "$used" "$q" 40)" "$(pct_str "$used" "$q")"
    local remain=$(( q - used )); (( remain < 0 )) && remain=0
    printf '  剩余 %s     日均 %s%s\n' "$(fmt_bytes "$remain")" "$(fmt_bytes "$avg")" "$(eta_text "$remain" "$avg" "$now")"
  else
    printf '  %s %s\n' "$(padr 配额 12)" "$(padl 未设置 44)"
    printf '  %s仅统计, 未启用任何限制%s   日均 %s\n' "$C_D" "$C_R" "$(fmt_bytes "$avg")"
  fi
  hr
  local lu ld inst
  read -r lu ld <<<"$(usage_life)"
  inst=$(cat "$STAMP" 2>/dev/null || echo 0)
  printf '  累计用量    自 %s 安装以来\n' "$( (( inst > 0 )) && date -d "@$inst" +%F || echo 未知 )"
  hr
  printf '  %s %s %s %s\n' "$(padr "" 12)" "$(padl 上传 14)" "$(padl 下载 14)" "$(padl 合计 14)"
  show_usage_block "流量" "$lu" "$ld"
  hr
  printf '  跑量 TOP3   %s\n' "$(top_ports 3)"
  local nlim nq
  nlim=$(awk -F'\t' '$6=="on"' "$LIMITS" 2>/dev/null | grep -c .); [[ $nlim =~ ^[0-9]+$ ]] || nlim=0
  nq=$(nlines "$PQUOTA")
  printf '  超额动作    整机 %s      端口 %s (配额 %s 个)     限速规则 %s 条\n' \
    "$( [[ ${ENFORCE_HOST:-0} == 1 ]] && echo 开启 || echo 关闭 )" \
    "$( [[ ${ENFORCE_PORT:-0} == 1 ]] && echo 开启 || echo 关闭 )" "$nq" "$nlim"
  local nerr; nerr=$(grep -c 'ERROR' "$LOG" 2>/dev/null); [[ $nerr =~ ^[0-9]+$ ]] || nerr=0
  printf '  运行日志    %s 行        异常 %s 条%s\n' \
    "$(wc -l < "$LOG" 2>/dev/null || echo 0)" "$nerr" \
    "$( (( nerr > 0 )) && printf '   %s见菜单 9%s' "$C_Y" "$C_R" )"
  # 以实际表存在与否为准, 不只看状态文件
  if enforce_host_active; then
    printf '  %s超额限速生效中: %s%s\n' "$C_E" "$(cat "$ENF_STATE" 2>/dev/null || echo "整机限速表 $(enf_table) 存在")" "$C_R"
  elif [[ -f $ENF_STATE ]]; then
    printf '  %s提示: 限速表已不存在, 残留状态文件将在下轮采集清理%s\n' "$C_D" "$C_R"
  fi
  local nenf; nenf=$(awk -F'\t' -v t="$ENF_TAG" '$7==t' "$LIMITS" 2>/dev/null | grep -c .); [[ $nenf =~ ^[0-9]+$ ]] || nenf=0
  (( nenf > 0 )) && printf '  %s端口超额限速生效中: %s 个%s\n' "$C_E" "$nenf" "$C_R"
  hr
  printf '  %s单位为十进制: 1KB=1000B, 1MB=1000KB, 1GB=1000MB, 1TB=1000GB%s\n' "$C_D" "$C_R"
  hr
}

top_ports() {
  local n=${1:-3} total=0
  # 分母用端口小计: 端口计数与网卡计数是两套口径, 转发机端口和可能超过网卡值
  while IFS=$'\t' read -r k u d; do
    [[ $k == nic || -z ${k:-} ]] && continue
    [[ $u =~ ^[0-9]+$ ]] || continue
    [[ $d =~ ^[0-9]+$ ]] || continue
    total=$(( total + u + d ))
  done < <(cat "$CYCLE" 2>/dev/null)
  (( total == 0 )) && { printf '无数据'; return; }
  local out; out=$(
    while IFS=$'\t' read -r k u d; do
      [[ $k == nic || -z ${k:-} ]] && continue
      [[ $u =~ ^[0-9]+$ && $d =~ ^[0-9]+$ ]] || continue
      echo "$(( u + d ))|$k"
    done < <(cat "$CYCLE" 2>/dev/null) | sort -t'|' -k1,1 -rn | head -n "$n" | \
    while IFS='|' read -r v k; do printf '%s %s   ' "$k" "$(pct_str "$v" "$total")"; done )
  printf '%s' "${out:-无数据}"
}

# ---------------------------------------------------------------- 端口明细
show_ports() {
  local scope=${1:-cycle} f label
  [[ $scope == life ]] && { f=$LIFE; label="自安装以来"; } || { f=$CYCLE; label="本期"; }
  local tu td ttot
  read -r tu td <<<"$(acc_get nic "$f")"; ttot=$(( tu + td ))
  # 先算端口小计, 作为占比分母 (端口与网卡是两套口径)
  local ptot=0 k u d
  while IFS=$'\t' read -r k u d; do
    [[ $k == nic || -z ${k:-} ]] && continue
    [[ $u =~ ^[0-9]+$ && $d =~ ^[0-9]+$ ]] || continue
    ptot=$(( ptot + u + d ))
  done < <(cat "$f" 2>/dev/null)

  title "端口流量明细    $label"
  hr
  printf '  %s %s %s %s %s %s  %s\n' "$(padr 端口 17)" "$(padr 类型 4)" "$(padl 上传 13)" "$(padl 下载 13)" "$(padl 合计 13)" "$(padl 占比 7)" 备注
  local pu=0 pd=0 shown=0
  # 排序口径与 top_ports 保持一致: 按 上传+下载 合计, 而非只按上传
  while IFS=$'\t' read -r k u d; do
    [[ $k == nic || -z ${k:-} ]] && continue
    [[ $u =~ ^[0-9]+$ && $d =~ ^[0-9]+$ ]] || continue
    local pline kind note state q mark=""
    pline=$(tsv_get "$k" "$PORTS")
    kind=$(printf '%s' "$pline" | cut -f4); note=$(printf '%s' "$pline" | cut -f5)
    state=$(printf '%s' "$pline" | cut -f8)
    case $kind in local) kind=本机;; fwd) kind=转发;; redir) kind=跳跃;; *) kind=历史;; esac
    if [[ -z $pline ]]; then
      # 端口已移出监控清单, 但本期/累计仍留有流量记录, 明确标注避免误解为统计错误
      mark=" [已移除, 仅存历史统计]"
    elif [[ ${state:-live} == gone ]]; then
      mark=" [已下线]"
    fi
    # SSH 标注同样按区间覆盖判断
    local kport=${k%%/*}
    port_overlaps_ssh "$kport" && [[ $k == *"/tcp" ]] && note="SSH ${note:-}"
    q=$(pquota_get "$k")
    (( q > 0 )) && mark="$mark [配额 $(fmt_bytes "$q") $(pct_str "$(pbasis_value "$u" "$d")" "$q")]"
    printf '  %s %s %s %s %s %s  %s\n' "$(padr "$k" 17)" "$(padr "$kind" 4)" \
      "$(padl "$(fmt_bytes "$u")" 13)" "$(padl "$(fmt_bytes "$d")" 13)" "$(padl "$(fmt_bytes "$((u+d))")" 13)" \
      "$(padl "$(pct_str "$((u+d))" "$ptot")" 7)" "${note:--}$mark"
    pu=$(( pu + u )); pd=$(( pd + d )); shown=$(( shown + 1 ))
  done < <(awk -F'\t' 'BEGIN{OFS="\t"} $1!="" && $2 ~ /^[0-9]+$/ && $3 ~ /^[0-9]+$/ {print $2+$3, $1, $2, $3}' "$f" 2>/dev/null \
           | sort -k1,1 -rn | cut -f2-)
  (( shown == 0 )) && printf '  %s暂无端口流量数据%s\n' "$C_D" "$C_R"
  hr
  printf '  %s %s %s %s\n' "$(padr 端口合计 22)" "$(padl "$(fmt_bytes "$pu")" 13)" "$(padl "$(fmt_bytes "$pd")" 13)" "$(padl "$(fmt_bytes "$((pu+pd))")" 13)"
  printf '  %s %s %s %s\n' "$(padr 网卡实测 22)" "$(padl "$(fmt_bytes "$tu")" 13)" "$(padl "$(fmt_bytes "$td")" 13)" "$(padl "$(fmt_bytes "$ttot")" 13)"
  printf '  %s占比按端口小计计算; 网卡为独立口径, 配额判定以网卡为准%s\n' "$C_D" "$C_R"
