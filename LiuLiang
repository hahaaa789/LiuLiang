    show_dashboard
    echo
    echo "    1)  安装部署 / 重新配置"
    echo "    2)  配额与计费周期"
    echo "    3)  超额动作"
    echo "    4)  限速规则"
    echo "    5)  端口流量明细"
    echo "    6)  端口监控清单"
    echo "    7)  采集服务状态"
    echo "    8)  系统诊断"
    echo "    9)  运行日志"
    echo "    h)  历史用量"
    echo "    0)  退出"
    printf '\n  回车 = 刷新\n  请选择: '
    if ! read -r c; then echo; echo "  输入已结束, 退出。"; exit 0; fi
    case ${c:-refresh} in
      1) menu_deploy ;;
      2) menu_quota ;;
      3) menu_enforce ;;
      4) menu_limits ;;
      5) while :; do
           clear 2>/dev/null; show_ports "${PSCOPE:-cycle}"
           echo "    1)  切换视图  本期 / 累计"
           echo "    0)  返回"
           printf '\n  回车返回\n  请选择: '
           read -r cc || break
           case ${cc:-0} in
             1) [[ ${PSCOPE:-cycle} == cycle ]] && PSCOPE=life || PSCOPE=cycle ;;
             *) break ;;
           esac
         done ;;
      6) menu_portlist ;;
      7) menu_service ;;
      8) menu_diag ;;
      9) menu_log ;;
      h|H) clear 2>/dev/null; show_history; pause ;;
      0) echo; exit 0 ;;
      refresh) ;;
      *) echo "  无效选择"; pause ;;
    esac
  done
}

do_status() {
  cfg_load
  local u d lu ld used
  read -r u d <<<"$(usage_cycle)"; read -r lu ld <<<"$(usage_life)"
  used=$(basis_value "$u" "$d")
  printf 'host=%s iface=%s ip=%s\n' "$(hostname 2>/dev/null || cat /etc/hostname 2>/dev/null || echo localhost)" "${RIFACE:-none}" "${RIP:-none}"
  printf 'cycle_up=%s cycle_down=%s cycle_total=%s\n' "$u" "$d" "$((u+d))"
  printf 'life_up=%s life_down=%s life_total=%s\n' "$lu" "$ld" "$((lu+ld))"
  printf 'quota=%s basis=%s used=%s pct=%s\n' "${QUOTA:-0}" "${QUOTA_BASIS:-total}" "$used" \
    "$( (( ${QUOTA:-0} > 0 )) && pct_str "$used" "$QUOTA" || echo n/a )"
  printf 'enforce_host=%s enforce_port=%s limited=%s\n' "${ENFORCE_HOST:-0}" "${ENFORCE_PORT:-0}" "$( enforce_host_active && echo yes || echo no )"
  printf 'ssh_exempt=%s\n' "${RSSH_LIST:-$RSSH}"
  printf 'iface_ok=%s\n' "$( require_iface && echo yes || echo "no:${IFACE_ERR:-unknown}" )"
  printf 'unit=decimal (1KB=1000B)\n'
  printf 'human: 本期 上传 %s 下载 %s 合计 %s | 累计 %s\n' \
    "$(fmt_bytes "$u")" "$(fmt_bytes "$d")" "$(fmt_bytes "$((u+d))")" "$(fmt_bytes "$((lu+ld))")"
}

# ---------------------------------------------------------------- 入口
# --collect / --status 必须先检查 root, 且要在执行前拦截。
# 非 root 时若放行, 不会报错而是产出错误结果: --status 打印全 0 会被误当作
# 真实用量, --collect 的写入与 nft 读取全部失败却只落日志。
_need_root() {
  [[ $EUID -eq 0 ]] && return 0
  echo "trafmgr: $1 需要 root 权限 (否则无法读取 nft 计数与写入状态目录)" >&2
  return 1
}

main() {
  local arg=${1:-}
  case $arg in
    --version|-v) echo "trafmgr v$VERSION"; exit 0 ;;
    --help|-h) cat <<EOF
trafmgr v$VERSION  流量统计与管理

用法:
  bash <(curl -sL URL)        交互模式, 未安装则进入安装向导
  bash <(curl -sL URL) 1      全自动安装, 全部默认值, 零提问
  bash <(curl -sL URL) 2      卸载, 保留统计数据
  bash <(curl -sL URL) 3      彻底卸载, 连数据一起删除
  bash <(curl -sL URL) 4      仅更新脚本, 配置与数据保留
  bash <(curl -sL URL) 5      打印状态后退出, 巡检/批量采集用

单位说明:
  容量  十进制  1KB=1000B  1MB=1000KB  1GB=1000MB  1TB=1000GB
        手动输入不带单位时按 GB 解释, 如 500 即 500GB
        显式写 KiB/MiB/GiB/TiB 时按 1024 换算
  速率  比特率  1M = 1Mbps = 1000000 bit/s

已安装后同样可用: trafmgr / trafmgr 1 / trafmgr 5 ...
EOF
      exit 0 ;;
    --collect)
      _need_root "--collect" || exit 1
      sweep_stale_tmp          # 顺带清理历史残留临时文件
      do_collect; exit $? ;;   # do_collect 内部已 cfg_load, 无需重复
    --status|5)
      _need_root "--status" || exit 1
      do_status; exit 0 ;;
    --selftest)                # 供冒烟测试与上线前人工验证使用
      _need_root "--selftest" || exit 1
      cfg_load; nft_selftest; exit $? ;;
  esac

  [[ $EUID -eq 0 ]] || { echo "trafmgr 需要 root 权限"; exit 1; }
  cfg_load

  # 用 if/else 而非 A && B || C: 后者在 B 失败时会误触发 C
  case $arg in
    1) do_install 1; exit 0 ;;
    2) if [[ ${2:-} == -y ]]; then do_uninstall 0 1; else do_uninstall 0 0; fi; exit 0 ;;
    3) if [[ ${2:-} == -y ]]; then do_uninstall 1 1; else do_uninstall 1 0; fi; exit 0 ;;
    4) do_update; exit $? ;;
  esac

  if [[ ! -f $CFG ]]; then
    # 未安装且无终端: 无法走交互向导, 提示用全自动安装
    if ! have_tty; then
      echo "trafmgr 尚未安装, 且当前无交互终端。"
      echo "请使用全自动安装:  bash <(curl -sL \$URL) 1"
      exit 1
    fi
    do_install 0
  fi
  require_tty || exit 1
  main_menu
}
main "$@"
