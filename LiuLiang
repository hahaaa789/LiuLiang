         else echo "  停止失败"; fi; pause ;;
      5) if nft_rebuild_safe; then echo "  已重建"; else echo "  重建失败, 详见菜单 9 日志"; fi; pause ;;
      6) ssh_cache_flush; cfg_load; echo "  已刷新: 网卡=${RIFACE:-未确定}  SSH豁免=${RSSH_LIST:-$RSSH}"; pause ;;
      0|"") return ;;
      *) echo "  无效选择"; pause ;;
    esac
  done
}

# ---------------------------------------------------------------- systemd
install_units() {
  local iv=${COLLECT_INTERVAL:-5}
  if ! cat > "$UNIT_DIR/trafmgr-collect.service" <<EOF
[Unit]
Description=trafmgr traffic collector
After=network.target nftables.service

[Service]
Type=oneshot
ExecStart=$BIN_PATH --collect
Nice=10
IOSchedulingClass=idle
EOF
  then loge "写入 service 单元失败 $UNIT_DIR/trafmgr-collect.service"; return 1; fi
  # 不要加 Persistent=true: 该选项只对 OnCalendar= 生效, 本 timer 用的是
  # OnBootSec/OnUnitActiveSec, 写了完全无效。且流量数取自 /sys 的累计计数器,
  # 关机期间本就没有流量, 补跑也没有意义
  if ! cat > "$UNIT_DIR/trafmgr-collect.timer" <<EOF
[Unit]
Description=trafmgr collector timer (every ${iv}min)

[Timer]
OnBootSec=1min
OnUnitActiveSec=${iv}min
AccuracySec=30s

[Install]
WantedBy=timers.target
EOF
  then loge "写入 timer 单元失败 $UNIT_DIR/trafmgr-collect.timer"; return 1; fi
  # daemon-reload 失败只告警: 单元文件已写入, 手动 reload 仍可挽回
  if ! systemctl daemon-reload 2>/dev/null; then
    logw "systemctl daemon-reload 失败, 单元可能未被重新读取"
  fi
  if ! systemctl enable --now trafmgr-collect.timer 2>/dev/null; then
    loge "systemd 定时器启用失败, 采集将不会自动运行"
    return 1
  fi
  audit "systemd 单元已写入, 采集间隔=${iv}分钟"
  return 0
}

# ---------------------------------------------------------------- 安装
show_probe() {
  local ifc ssh ip nlisten nnat
  ifc=$(detect_iface); ssh=$(detect_ssh_port); ip=$(detect_pubip "$ifc")
  nlisten=$(discover_listen | grep -c .); [[ $nlisten =~ ^[0-9]+$ ]] || nlisten=0
  nnat=$(discover_nat | grep -c .); [[ $nnat =~ ^[0-9]+$ ]] || nnat=0
  hr
  printf '  环境探测\n'
  hr
  printf '    系统          %s\n' "$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-未知}")"
  printf '    内核          %s   虚拟化 %s\n' "$(uname -r)" "$(systemd-detect-virt 2>/dev/null || echo 未知)"
  if [[ -n $ifc ]]; then
    printf '    网卡          %s   %s\n' "$ifc" "${ip:-无IPv4}"
  else
    printf '    %s网卡          探测失败, 未找到物理网卡%s\n' "$C_E" "$C_R"
  fi
  local v
  for v in $(ls "$SYSNET" 2>/dev/null); do
    [[ $v == lo || $v == "$ifc" ]] && continue
    is_virtual_if "$v" && printf '    %s %s\n' "$(padr "" 13)" "已排除虚拟接口 $v"
  done
  printf '    SSH 豁免端口  %s   多源汇总, 限速将强制豁免\n' "$(detect_ssh_ports)"
  printf '    nftables      %s   现有 %s 张表, 将新建独立表, 互不干扰\n' \
    "$(nft --version 2>/dev/null | awk '{print $2}')" "$(nft list tables 2>/dev/null | grep -c .)"
  printf '    %s              %s\n' "$(padr "" 13)" "$(nft_feature_note)"
  printf '    监听端口      发现 %s 个 (已跳过仅监听回环的)\n' "$nlisten"
  printf '    转发规则      发现 %s 条 DNAT/REDIRECT (仅解析 type nat 表)\n' "$nnat"
  local ntp; ntp=$(timedatectl show -p NTPSynchronized --value 2>/dev/null)
  [[ $ntp != yes ]] && printf '    %s时钟同步      未同步, 建议部署前修复%s\n' "$C_Y" "$C_R"
  hr
  PROBE_IF=$ifc
}

# 校验候选文件确实是一份完整可用的 trafmgr, 而非空文件/HTML 错误页/截断内容
# 除大小与语法外, 还校验版本号格式与关键函数是否齐全,
# 以拦下"被截断但恰好语法正确"的片段
_is_valid_self() {
  local f=$1 v
  [[ -s $f ]] || return 1
  (( $(wc -c < "$f") > 10000 )) || return 1        # 完整脚本远大于 10KB
  grep -q '^VERSION=' "$f" || return 1
  grep -q '^main "\$@"' "$f" || return 1           # 必须有入口调用, 确保未被截断
  # 版本号必须是 x.y[.z] 形式, 防止拿到占位/错误页
  v=$(awk -F'"' '/^VERSION=/{print $2; exit}' "$f")
  [[ $v =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]] || return 1
  # 关键函数必须齐全, 防止拿到被截断但恰好语法正确的片段
  local fn
  for fn in do_collect nft_build nft_limit_build enforce_check cfg_load main; do
    grep -qE "^${fn}\(\)" "$f" || return 1
  done
  bash -n "$f" 2>/dev/null || return 1
  return 0
}

# 覆盖二进制必须用"与目标同目录"的临时文件 + mv, 才能真正 rename 换 inode。
# 若临时文件建在 /tmp, 跨文件系统时 mv 会退化成 O_TRUNC 复制, inode 不变,
# 正在运行的 bash 会按文件偏移继续读取, 解析到错乱内容。
# 同理也不能用 cp -f 直接覆盖正在执行的脚本。
_install_binary() {
  local src=$1 dst=$2 tmp
  mkdir -p "$(dirname "$dst")" 2>/dev/null || return 1
  tmp=$(mktemp "${dst}.XXXXXX") || { loge "无法在 $(dirname "$dst") 创建临时文件"; return 1; }
  if ! cat "$src" > "$tmp"; then loge "写入 $tmp 失败"; rm -f "$tmp"; return 1; fi
  chmod 755 "$tmp" 2>/dev/null
  if ! mv -f "$tmp" "$dst"; then loge "替换 $dst 失败"; rm -f "$tmp"; return 1; fi
  return 0
}

# 主程序落盘
# 关键: bash <(curl ...) 时 BASH_SOURCE 是 /dev/fd/NN, 这是个"已被消费的流",
#       cat 它只能读到 bash 尚未解析的剩余部分, 复制出来必然是残缺的。
#       cat | bash 时 BASH_SOURCE 甚至为空。
#       因此只有"真实普通文件"才能直接复制, 其余一律从仓库重新下载。
install_self() {
  local src=${BASH_SOURCE[0]:-}

  # 已经就位, 无需处理
  if [[ -n $src && -f $src ]] && [[ $src -ef $BIN_PATH ]] 2>/dev/null; then
    return 0
  fi

  # 方式1 源是真实普通文件 (curl -o 后再 bash 执行 / 本地已安装后调用)
  if [[ -n $src && -f $src && -r $src ]]; then
    local tmp; tmp=$(mktemp)
    if cat "$src" > "$tmp" 2>/dev/null && _is_valid_self "$tmp"; then
      if _install_binary "$tmp" "$BIN_PATH"; then
        rm -f "$tmp"
        audit "主程序安装至 $BIN_PATH (来源 $src)"
        return 0
      fi
    fi
    rm -f "$tmp"
  fi

  # 方式2 从仓库下载 (进程替换 / 管道执行时的唯一可靠途径)
  local tmp; tmp=$(mktemp)
  logi "当前为流式执行 (源=${src:-stdin}), 从仓库下载主程序以确保完整"
  if { curl -fsSL -m 60 "$REPO_RAW" -o "$tmp" 2>/dev/null || wget -qO "$tmp" "$REPO_RAW" 2>/dev/null; } \
     && _is_valid_self "$tmp"; then
    if _install_binary "$tmp" "$BIN_PATH"; then
      rm -f "$tmp"
      audit "主程序安装至 $BIN_PATH (来源 $REPO_RAW)"
      return 0
    fi
  fi
  rm -f "$tmp"

  loge "主程序落盘失败: 源=${src:-stdin} 仓库=$REPO_RAW"
  echo
  echo "  无法将主程序写入 $BIN_PATH"
  echo "  原因: 流式执行无法自我复制, 且从仓库下载失败 (网络或地址问题)"
  echo
  echo "  请改用先下载再执行的方式:"
  echo "    curl -fsSL $REPO_RAW -o /tmp/trafmgr.sh"
  echo "    bash /tmp/trafmgr.sh"
  return 1
}

do_install() {
  local auto=${1:-0}
  LOG_TAG=install
  [[ $EUID -eq 0 ]] || { echo "  需要 root 权限"; exit 1; }
  nft_ok || { echo "  未安装 nftables, 请先执行: apt update && apt install -y nftables"; exit 1; }
  mkdir -p "$CFG_DIR" "$LIB_DIR" "$DAILY_DIR" "$STATE_DIR"
  touch "$PORTS" "$LIMITS" "$PQUOTA" "$CYCLE" "$LIFE" "$SNAP"

  cfg_defaults
  cfg_read                 # 先吃掉已存在的配置, 让用户手写的 IFACE 能救场
  audit "===== 安装开始 v$VERSION  模式=$( [[ $auto == 1 ]] && echo 全自动 || echo 交互 ) ====="
  audit "安装前环境: 内核=$(uname -r) 发行版=$(. /etc/os-release 2>/dev/null; echo "${PRETTY_NAME:-未知}") nft=$(nft --version 2>/dev/null | awk '{print $2}')"
  audit "安装前 nft 表: $(nft list tables 2>/dev/null | tr '\n' ';' | sed 's/;$//')"

  # 网卡确定: 手写优先, 否则自动探测
  local pif
  if [[ ${IFACE:-auto} != auto ]]; then
    if [[ -d $SYSNET/$IFACE ]]; then
      pif=$IFACE; audit "采用配置文件指定网卡 $pif (跳过自动探测)"
    else
      loge "配置指定的网卡 $IFACE 不存在"
      echo "  错误: 配置文件里的 IFACE=$IFACE 不存在"
      echo "  可用接口: $(ls "$SYSNET" 2>/dev/null | tr '\n' ' ')"
      echo "  请修改 $CFG 后重试"
      exit 1
    fi
  else
    pif=$(detect_iface)
  fi
  if [[ -z $pif ]]; then
    loge "安装中止: 未探测到任何物理网卡"
    echo "  错误: 未找到物理网卡 (已排除虚拟接口)"
    echo "  可用接口: $(ls "$SYSNET" 2>/dev/null | tr '\n' ' ')"
    echo
    echo "  解决办法: 手动指定网卡后重新安装"
    echo "    mkdir -p $CFG_DIR"
    echo "    echo 'IFACE=你的网卡名' > $CFG"
    echo "    然后重新运行安装命令"
    exit 1
  fi

  if [[ $auto == 1 ]]; then
    echo "trafmgr: 探测 iface=$pif ip=$(detect_pubip "$pif") ssh=$(detect_ssh_ports)"
    echo "trafmgr: 配置 reset_day=$RESET_DAY quota=none basis=$QUOTA_BASIS interval=${COLLECT_INTERVAL}min"
    echo "trafmgr: 限制 host=off port=off"
  else
    clear 2>/dev/null
    printf '\n  %strafmgr  流量统计与管理%s   v%s\n\n' "$C_B" "$C_R" "$VERSION"
    echo "  未检测到已安装, 进入安装向导"
    show_probe
    printf '  将采用以下默认配置\n'
    hr
    printf '    监控网卡      %s  自动探测\n' "$PROBE_IF"
    printf '    计费重置日    每月 1 号\n'
    printf '    配额额度      未设置   仅统计, 不做任何限制\n'
    printf '    计费口径      合计  上传 + 下载\n'
    printf '    容量单位      十进制 KB/MB/GB/TB   输入不带单位按 GB 计\n'
    printf '    采集间隔      5 分钟\n'
    printf '    端口自动发现  开启   下线端口保留 30 天\n'
    printf '    超额限制      关闭   整机与端口均关闭\n'
    printf '    日志          运行 300 行 + 审计 1000 行\n'
    hr
    echo
    echo "    1)  按默认配置安装      推荐"
    echo "    2)  自定义配置后安装"
    echo "    0)  退出"
    printf '\n  回车 = 按默认安装\n  请选择: '; read -r c
    case ${c:-1} in
      2) install_wizard ;;
      0) echo "  已取消"; exit 0 ;;
    esac
  fi

  cfg_save || { echo "  错误: 配置写入失败, 安装中止"; exit 1; }
  audit "配置写入: IFACE=$IFACE RESET_DAY=$RESET_DAY QUOTA=$QUOTA BASIS=$QUOTA_BASIS INTERVAL=$COLLECT_INTERVAL AUTO_DISCOVER=$AUTO_DISCOVER ENFORCE_HOST=$ENFORCE_HOST ENFORCE_PORT=$ENFORCE_PORT"
  cfg_load

  install_self || { echo "  错误: 主程序落盘失败, 采集服务将无法运行"; exit 1; }
  [[ -f $STAMP ]] || { date +%s > "$STAMP"; audit "记录安装时间 $(date '+%F %T')"; }

  do_discover force
  audit "端口注册完成, 共 $(nlines "$PORTS") 个"

  # 关键步骤逐个校验, 失败就明确报错, 不能假装安装成功
  local _fail=0 _msg=""
  if ! nft_build; then
    _fail=1; _msg="nft 计数表建立失败${NFT_GUARD_ERR:+: $NFT_GUARD_ERR}"
    loge "安装失败: $_msg"
  fi
  if (( _fail == 0 )) && ! install_units; then
    _fail=1; _msg="systemd 单元写入或启用失败"
    loge "安装失败: $_msg"
  fi
  if (( _fail == 0 )) && ! do_collect; then
    _fail=1; _msg="首次采集失败: ${IFACE_ERR:-详见日志}"
    loge "安装失败: $_msg"
  fi
  if (( _fail == 1 )); then
    audit "===== 安装未完成: $_msg ====="
    echo
    printf '  %s安装未完成%s\n\n' "$C_E" "$C_R"
    echo "  原因: $_msg"
    echo "  已写入的配置保留于 $CFG, 修复后可重新运行安装"
    echo "  详细日志: $LOG"
    exit 1
  fi

  audit "===== 安装完成 ====="
  if [[ $auto == 1 ]]; then
    echo "trafmgr: 端口已注册 $(nlines "$PORTS") 个"
    echo "trafmgr: 安装完成, 采集已启动"
    [[ $(timedatectl show -p NTPSynchronized --value 2>/dev/null) != yes ]] && echo "trafmgr: 警告 系统时钟未与 NTP 同步"
  else
    echo
    printf '  %s安装完成%s\n\n' "$C_G" "$C_R"
    echo "  输入 trafmgr 进入管理菜单"
    echo "  统计已开始运行, 无需额外配置"
    echo
    echo "  提示  未设置配额时仅统计不限制"
    echo "        如需超额保护, 在菜单 2 设置配额, 菜单 3 开启限制"
    echo "  单位  容量为十进制 KB/MB/GB/TB, 填数字不带单位按 GB 计"
    echo "  日志  运行 $LOG"
    echo "        审计 $AUDIT   记录所有配置变更及变更前原值"
    pause
  fi
}

install_wizard() {
  echo
  echo "  自定义安装      每项直接回车即采用默认值"
  echo
  ask "[1/6] 监控网卡" "$(detect_iface)"
  if [[ -n $REPLY_VAL && ! -d $SYSNET/$REPLY_VAL ]]; then
    printf '  %s网卡 %s 不存在, 已回退为 auto%s\n' "$C_Y" "$REPLY_VAL" "$C_R"; IFACE=auto
  else IFACE=${REPLY_VAL:-auto}; fi
  ask "[2/6] 计费重置日 (1-28 或 last)" "1"
  if [[ $REPLY_VAL == last ]] || [[ $REPLY_VAL =~ ^([1-9]|1[0-9]|2[0-8])$ ]]; then RESET_DAY=$REPLY_VAL
  else printf '  %s无效, 已用默认 1%s\n' "$C_Y" "$C_R"; RESET_DAY=1; fi
  # 文案须与实际行为一致: 留空是"保持当前值", 不是"不设配额"
  local _qcur; _qcur=$( (( ${QUOTA:-0} > 0 )) && fmt_bytes "$QUOTA" || echo 未设置 )
  if ask_size "[3/6] 配额额度 (数字=GB, 如 500 即 500GB; 留空=保持当前 [$_qcur]; 填 0 =取消配额)" ""; then
    QUOTA=$SIZE_VAL
  fi
  echo "        1) 仅上传  2) 仅下载  3) 合计  4) 取上下较大"
  ask "[4/6] 计费口径" "3"
  case $REPLY_VAL in 1) QUOTA_BASIS=up;; 2) QUOTA_BASIS=down;; 4) QUOTA_BASIS=max;; *) QUOTA_BASIS=total;; esac
  ask "[5/6] 采集间隔 (分钟)" "5"
  if [[ $REPLY_VAL =~ ^[0-9]+$ ]] && (( REPLY_VAL >= 1 && REPLY_VAL <= 1440 )); then COLLECT_INTERVAL=$REPLY_VAL
  else printf '  %s无效, 已用默认 5%s\n' "$C_Y" "$C_R"; COLLECT_INTERVAL=5; fi
  echo "        1) 开启  2) 关闭"
  ask "[6/6] 端口自动发现" "1"; [[ $REPLY_VAL == 2 ]] && AUTO_DISCOVER=0 || AUTO_DISCOVER=1
  echo
  hr
  printf '  确认配置\n'
  printf '    网卡 %s   重置日 %s   配额 %s\n' "$IFACE" "$RESET_DAY" "$( (( QUOTA > 0 )) && fmt_bytes "$QUOTA" || echo 未设置 )"
  printf '    口径 %s   间隔 %s 分钟   自动发现 %s\n' "$(basis_name)" "$COLLECT_INTERVAL" "$( [[ $AUTO_DISCOVER == 1 ]] && echo 开启 || echo 关闭 )"
  printf '    超额限制 关闭   开机自启 开启\n'
  hr
}

# ---------------------------------------------------------------- 卸载 / 更新
do_uninstall() {
  local purge=${1:-0} yes=${2:-0}
  LOG_TAG=uninstall
  if (( yes == 0 )); then
    if (( purge == 1 )); then
      confirm_danger "将删除 trafmgr 及全部统计数据, 不可恢复" || { echo "  已取消"; return 0; }
    else
      confirm "确认卸载 trafmgr (保留统计数据)" || { echo "  已取消"; return 0; }
    fi
  fi
  audit "===== 卸载开始  purge=$purge ====="
  systemctl disable --now trafmgr-collect.timer 2>/dev/null
  rm -f "$UNIT_DIR/trafmgr-collect.service" "$UNIT_DIR/trafmgr-collect.timer"
  systemctl daemon-reload 2>/dev/null
  # 连同历史表名一起清理, 避免改过名后留下无人管理的孤儿表
  local t=${NFT_TABLE:-$NFT_TABLE_DEFAULT} old tb
  old=$(cat "$TABLE_STATE" 2>/dev/null)
  local -a bases=("$t")
  [[ -n ${old:-} && $old != "$t" ]] && bases+=("$old")
  local b
  for b in "${bases[@]}"; do
    for tb in "$b" "${b}_lim" "${b}_enf"; do
      if nft_table_exists "$tb"; then
        if nft_delete_own_table "$tb"; then audit "移除 nft 表 inet $tb"
        else audit "保留 nft 表 inet $tb (非 trafmgr 创建或删除失败, 未删除)"; fi
      fi
    done
  done
  audit "卸载后 nft 表: $(nft list tables 2>/dev/null | tr '\n' ';' | sed 's/;$//')"
  if (( purge == 1 )); then
    audit "删除数据目录 $LIB_DIR 与配置 $CFG_DIR"
    rm -rf "$LIB_DIR" "$CFG_DIR"
    echo "  已彻底卸载, 数据已删除"
  else
    echo "  已卸载, 统计数据保留于 $LIB_DIR"
  fi
  rm -f "$BIN_PATH"
  audit "===== 卸载完成 ====="
  echo "  日志保留于 $LOG 与 $AUDIT"
  return 0
}

# 更新流程: 下载 -> 校验 -> 备份 -> 同目录 mv 替换 -> 自检 -> 失败回滚。
# 用 mv 而非 cp 的原因见 _install_binary 上方说明。
do_update() {
  LOG_TAG=update
  local tmp; tmp=$(mktemp) || return 1
  echo "  正在下载最新版本..."
  if ! curl -fsSL -m 30 "$REPO_RAW" -o "$tmp" 2>/dev/null; then
    loge "下载失败 $REPO_RAW"; echo "  下载失败, 请检查网络"; rm -f "$tmp"; return 1
  fi
  if ! _is_valid_self "$tmp"; then
    loge "下载的脚本校验失败, 已放弃更新"
    echo "  更新失败: 文件校验不通过 (可能拿到错误页或内容被截断)"
    rm -f "$tmp"; return 1
  fi
  local ov nv bak
  ov=$VERSION; nv=$(awk -F'"' '/^VERSION=/{print $2; exit}' "$tmp")
  if [[ $nv == "$ov" ]]; then
    echo "  当前已是 v$ov, 仍将重新安装以修复可能损坏的文件"
  fi
  # 备份现有二进制, 便于自检失败时回滚
  bak=""
  if [[ -f $BIN_PATH ]]; then
    bak="${BIN_PATH}.bak.$$"
    if ! cp -f "$BIN_PATH" "$bak"; then
      loge "无法备份 $BIN_PATH, 放弃更新"; echo "  更新失败: 无法创建备份"; rm -f "$tmp"; return 1
    fi
  fi
  if ! _install_binary "$tmp" "$BIN_PATH"; then
    echo "  更新失败: 写入 $BIN_PATH 出错"
    [[ -n $bak ]] && mv -f "$bak" "$BIN_PATH"
    rm -f "$tmp"; return 1
  fi
  rm -f "$tmp"
  # 受控自检: 语法 + 能否正常打印版本
  local ok=1
  bash -n "$BIN_PATH" 2>/dev/null || ok=0
  if (( ok == 1 )); then
    local vout; vout=$("$BIN_PATH" --version 2>/dev/null)
    [[ $vout == *"trafmgr v"* ]] || ok=0
  fi
  if (( ok == 0 )); then
    loge "更新后自检失败, 正在回滚"
    if [[ -n $bak ]] && mv -f "$bak" "$BIN_PATH"; then
      echo "  更新后自检失败, 已回滚到 v$ov"
      audit "更新自检失败, 已回滚至 v$ov"
    else
      echo "  更新后自检失败, 且回滚失败! 请手动重新安装:"
      echo "    curl -fsSL $REPO_RAW -o /tmp/trafmgr.sh && bash /tmp/trafmgr.sh"
      audit "更新自检失败且回滚失败, 需人工介入"
    fi
    return 1
  fi
  [[ -n $bak ]] && rm -f "$bak"
  # 单元文件可能随版本变化, 覆盖后重装一次
  install_units >/dev/null 2>&1 || logw "更新后 systemd 单元重装失败, 请到菜单 7 手动重启采集服务"
  audit_change "脚本版本" "$ov" "${nv:-未知}" "配置与数据保留, 自检通过"
  echo "  已更新至 ${nv:-未知}, 配置与统计数据均保留 (自检通过)"
  return 0
}

menu_deploy() {
  while :; do
    cfg_load
    local inst; inst=$(cat "$STAMP" 2>/dev/null || echo 0)
    title "安装部署 / 重新配置"
    printf '    安装状态      已安装   %s\n' "$( (( inst > 0 )) && date -d "@$inst" '+%F %T' || echo 未知 )"
    printf '    脚本版本      v%s\n' "$VERSION"
    printf '    安装路径      %s\n' "$BIN_PATH"
    printf '    配置文件      %s\n' "$CFG"
    printf '    数据目录      %s   %s\n' "$LIB_DIR" "$(du -sh "$LIB_DIR" 2>/dev/null | cut -f1)"
    printf '    当前网卡      %s\n' "$( [[ -n ${RIFACE:-} ]] && echo "$RIFACE" || printf '%s未确定%s' "$C_E" "$C_R" )"
    printf '    采集服务      %s   间隔 %s 分钟\n' "$(systemctl is-active trafmgr-collect.timer 2>/dev/null || echo 未安装)" "${COLLECT_INTERVAL:-5}"
    echo
    echo "    1)  重新运行配置向导      保留统计数据"
    echo "    2)  重新探测环境并应用"
    echo "    3)  查看当前完整配置"
    echo "    4)  导出配置              用于批量部署"
    echo "    5)  更新脚本到最新版"
    echo "    6)  卸载                  保留数据"
    echo "    7)  彻底卸载              连数据一起删"
    echo "    0)  返回"
    printf '\n  回车返回\n  请选择: '
    read -r c || return 0
    case ${c:-0} in
      1) install_wizard
         if confirm "确认应用"; then
           if cfg_save; then
             audit "配置向导重新应用"; cfg_load; nft_rebuild_safe; install_units; echo "  已应用"
           else echo "  配置保存失败, 未应用"; fi
         fi; pause ;;
      2) local oi=${RIFACE:-无} os=${RSSH:-无}
         ssh_cache_flush          # 重新探测必须绕过缓存
         cfg_load
         audit "重新探测: 网卡 $oi -> ${RIFACE:-未找到}   SSH $os -> ${RSSH:-未知}"
         if require_iface; then
           do_discover force
           if nft_rebuild_safe; then echo "  已重新探测并应用, 网卡=$RIFACE  SSH豁免=${RSSH_LIST:-$RSSH}"
           else echo "  探测完成但计数表重建失败, 详见菜单 9 日志"; fi
         else echo "  探测失败: ${IFACE_ERR:-未找到物理网卡}"; fi; pause ;;
      3) echo; sed 's/^/  /' "$CFG"; pause ;;
      4) echo; echo "  以下为可批量下发的配置 (已移除本机特有项):"; echo
         grep -vE '^(IFACE|PUBLIC_IP|SSH_PORT)=' "$CFG" | sed 's/^/  /'
         echo "  IFACE=auto"; echo "  PUBLIC_IP=auto"; echo "  SSH_PORT=auto"; pause ;;
      5) do_update; pause ;;
      6) do_uninstall 0; exit 0 ;;
      7) do_uninstall 1; exit 0 ;;
      0|"") return ;;
      *) echo "  无效选择"; pause ;;
    esac
  done
}

