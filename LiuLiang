# ---------------------------------------------------------------- 菜单工具
# 是否具备交互条件: stdin 必须是终端
# curl | bash 时 stdin 是管道, read 立即返回 EOF, 菜单会无限空转
have_tty() { [[ -t 0 ]]; }
require_tty() {
  have_tty && return 0
  echo
  echo "  当前为非交互环境 (stdin 不是终端), 无法进入管理菜单。"
  echo
  echo "  如果你用的是   curl -sL URL | bash   或   bash <(curl -sL URL)  且未连终端,"
  echo "  请改用下面任一方式:"
  echo "    1) 先下载再执行:  curl -fsSL $REPO_RAW -o /tmp/trafmgr.sh && bash /tmp/trafmgr.sh"
  echo "    2) 安装后直接运行: trafmgr"
  echo "    3) 非交互子命令:   trafmgr 1 (全自动安装) / trafmgr 5 (打印状态) / trafmgr --collect"
  echo
  return 1
}
ask() {
  local p=$1 def=${2:-} ans
  if [[ -n $def ]]; then printf '  %s [回车=%s]: ' "$p" "$def"; else printf '  %s [回车跳过]: ' "$p"; fi
  if ! read -r ans; then REPLY_VAL=$def; return 1; fi
  REPLY_VAL=${ans:-$def}
  return 0
}
confirm() {
  local p=$1 ans
  printf '  %s [y/N]: ' "$p"
  read -r ans || return 1        # 无输入一律视为否定, 不能默认执行危险操作
  [[ ${ans,,} == y || ${ans,,} == yes ]]
}
confirm_danger() {
  local p=$1 ans
  printf '  %s%s%s\n  必须输入 yes 确认: ' "$C_E" "$p" "$C_R"
  read -r ans || return 1
  [[ $ans == yes ]]
}
pause() { have_tty || return 0; printf '\n  回车继续: '; read -r _ || true; }

# 交互式读取端口号, 带校验与重试
ask_port() {
  local p tries=0
  while (( tries < 3 )); do
    ask "${1:-端口号 (如 8443 或 60000-62700)}" ""
    [[ -z $REPLY_VAL ]] && { PORT_VAL=""; return 1; }
    if valid_port "$REPLY_VAL"; then PORT_VAL=${REPLY_VAL// /}; return 0; fi
    printf '  %s%s%s\n' "$C_E" "${PORT_ERR:-无效端口}" "$C_R"
    tries=$(( tries + 1 ))
  done
  PORT_VAL=""; return 1
}
# 容量输入: 不带单位按 GB 解释, 输入后回显确认值避免误填
ask_size() {   # $1=提示 $2=默认 -> SIZE_VAL
  local tries=0 v
  while (( tries < 3 )); do
    ask "$1" "${2:-}"
    [[ -z $REPLY_VAL ]] && { SIZE_VAL=""; return 1; }
    v=$(parse_size "$REPLY_VAL")
    if [[ $v != ERR ]]; then
      SIZE_VAL=$v
      # 纯数字输入时明确提示按 GB 解释, 防止用户以为填的是 MB 或字节
      [[ $REPLY_VAL =~ ^[0-9]+(\.[0-9]+)?$ ]] && (( v > 0 )) \
        && printf '  %s已按 GB 解释: %s = %s%s\n' "$C_D" "$REPLY_VAL" "$(fmt_bytes "$v")" "$C_R"
      return 0
    fi
    printf '  %s格式无法识别。直接填数字按 GB 计 (500 = 500GB), 也可写 500G / 2T / 4.5TB / 800M%s\n' "$C_E" "$C_R"
    tries=$(( tries + 1 ))
  done
  SIZE_VAL=""; return 1
}
ask_rate() {   # $1=提示 $2=默认 -> RATE_VAL
  local tries=0
  while (( tries < 3 )); do
    ask "$1" "${2:-}"
    [[ -z $REPLY_VAL ]] && { RATE_VAL=""; return 1; }
    [[ $(parse_rate_kbs "$REPLY_VAL") != ERR ]] && { RATE_VAL=$REPLY_VAL; return 0; }
    printf '  %s速率格式错误, 应为 1M / 100M / 500K (按比特率, 1M = 1Mbps)%s\n' "$C_E" "$C_R"
    tries=$(( tries + 1 ))
  done
  RATE_VAL=""; return 1
}

# ---------------------------------------------------------------- 菜单: 配额
menu_quota() {
  while :; do
